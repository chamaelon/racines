   },
   "personnage": "Narrateur",
   "intonation": "grave",
   "intonation_statut": "scénario",
   "texte": "Mais la grande sécheresse brûlait la brousse. Le gibier se faisait rare.",
   "genre": "adulte/libre",
   "duree_ms": 5500,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
