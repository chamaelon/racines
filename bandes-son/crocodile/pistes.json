   "duree_ms": 8500,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Haa hande, koo toɓɓe saare kassena'en ɗon ɗaɓɓa ko crocodile woni totem. On meeɗaay yi'ugo mo o hisni en.",
     "relecture": "traduction automatique, non relue",
