   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Abem était chasseur, l'ancêtre d'une famille kassena. Il partit, comme chaque jour, avec son arc.",
   "genre": "adulte/libre",
   "duree_ms": 7800,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Abem laati mannguɗo, mawɗo saare Kassena. O wurti, bana no o waɗata nder nyalawma fuu, bee kaŋŋe maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "A Abem ra yaa zĩm-biisi, la a yaa Kassena zakã yaab. A ra zãada a boog n loogda, wa a sẽn da maand daar fãa wã.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
