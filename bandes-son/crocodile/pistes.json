   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "La grande sécheresse (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Abem était chasseur, l'ancêtre d'une famille kassena. La grande sécheresse brûle la brousse, et le gibier se fait rare. Une antilope passe au loin. Que fais-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 11760,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Abem laati mannguɗo, mawɗo saare Kassena. Duuɗeeje mawɗe ɗon halki le'i, e yiite ɗe ɗon ɓeyda. Antilope ɗon yaha haa yaasi. Ko honɗun waɗata?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10718,
     "fichier": "crocodile-n1-fuf.m4a"
    },
    "mos": {
     "texte": "A Abem ra yaa zĩm-biisi, la a yaa Kassena zakã yaab. Kɩɩm-kãsengã rɩka bugum, la namsgã paoodame. Bãng-y t'a Antɩlopã kẽnda yɩɩga. Bõe la fo maanda?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14350,
     "fichier": "crocodile-n1-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n1.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n1.choices.0.label",
   "texte": "Tu la suis, il faut nourrir les tiens",
   "langues": {
    "fuf": {
     "texte": "On ɗon tokka mo, sey on nyaama ɓikkoy mooɗon",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "Fo tũuda-a lame, fo segd n dɩka f kambã rɩɩbo",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
