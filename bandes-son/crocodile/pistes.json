     "fichier": "crocodile-tire-fuf.m4a"
    },
    "mos": {
     "texte": "Fo sã n na n zãag f sɩbgrã, bõn-naandgã na n loogame. Woto yĩnga, ned pa le tõe n wilg-f t'a yaa a soaba ye. D sã n wa yãend-y wakat sẽn kaoos, y zakã rãmb pa na n maan pʋlem ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13764,
     "fichier": "crocodile-tire-mos.m4a"
    }
