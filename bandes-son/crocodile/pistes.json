   "partie": "Le crocodile (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Tu marches encore un peu, puis tu tombes. Quelque chose bouge dans les herbes : un crocodile, loin de toute eau. Tes mains tremblent sur ton arc.",
   "genre": "adulte/homme",
   "duree_ms": 11610,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "A ɗon yaha yeeso, nden a ɗon maayi. Koo ɗume ɗon hooda nder leɗɗe, ko crocodile, yaasi ndiyam fuu. Juŋŋgo maaɗa ɗon hoosi dow maago maaɗa.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10852,
     "fichier": "crocodile-n2-fuf.m4a"
    },
    "mos": {
     "texte": "Y sã n ket n kẽnd bilf bɩ y lʋɩ. Bũmb n be we-kãnga pʋgẽ: bõn-buud sẽn zãr ne koomã. Yãmb nusã tãsdda y noore.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8670,
     "fichier": "crocodile-n2-mos.m4a"
    }
