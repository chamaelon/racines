   "partie": "La grande sécheresse (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au village, les enfants ont faim. Le lendemain, tu repars, et l'antilope est encore là. Tu la suis.",
   "genre": "adulte/homme",
   "duree_ms": 8190,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ɓiɓɓe nder gariiri ɗon njaafa. To ndeen, to a yehi, antilope ɗon haaje. On ɗon tokkimo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7172,
     "fichier": "crocodile-rentre-fuf.m4a"
    },
    "mos": {
     "texte": "Tẽngã pʋgẽ, kom-bɩɩsã komdame. A vẽkembeoogo, fo sã n lebg n kẽngẽ, a ket n bee be. Fo tũuda-a lame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9380,
     "fichier": "crocodile-rentre-mos.m4a"
    }
   }
  },
  {
   "id": "suit",
   "type": "replique",
   "chemin": "nodes.suit.text",
   "noeud": "suit",
   "partie": "La grande sécheresse (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Tu la suis de plus en plus loin. Quand tu t'arrêtes, tu ne reconnais plus rien. Le soleil est haut, et la soif te prend. Tu secoues ta gourde : elle est vide.",
   "genre": "adulte/homme",
   "duree_ms": 14190,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "A ɗon ɓeyda bee maako. To a ummi, a anndaa kooɗume. Ɗuum woni naange, nden kam yiite nyaamoto ma. On ɗon moƴƴina ko'e mon, ɗe meere.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10542,
     "fichier": "crocodile-suit-fuf.m4a"
    },
    "mos": {
     "texte": "Fo tũuda-a lame n paasdẽ. Fo sã n wa kaoose, fo pa le mi bũmb ye. Wĩndgã yikame, tɩ ko-yũud yõk foom. Fo sã n ning f gãndã, a ka tarẽ ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14798,
     "fichier": "crocodile-suit-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
