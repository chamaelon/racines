   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le crocodile ne mord pas. Du museau, il te pousse doucement. Tu te relèves. Il avance, puis il se retourne, comme pour dire : suis-moi.",
   "genre": "adulte/homme",
   "duree_ms": 11300,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Krokodil naa nyaamataa. O ɓeydaani ma bee hakkiilo. A ɗon ummii. O yahi yeeso, o yaari, o wi'i: \"Taa yam\".",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9960,
     "fichier": "crocodile-confiance-fuf.m4a"
    },
    "mos": {
     "texte": "Ko-kãnga pa wãbd ye. A naaga yãmb ne sũ-bʋgsem. Yãmb yikdame. A Zezi kẽngame n yaool n wẽnemd b poorẽ n yeel-b yaa: \"Bɩ y tũ maam\".",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11256,
     "fichier": "crocodile-confiance-mos.m4a"
    }
   }
