   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Les voici dans la région de Bobo. Ici, la terre a déjà ses maîtres. Toi, tu observes Famagan. Sur quoi portes-tu ton attention ?",
   "genre": "adulte/homme",
   "duree_ms": 10620,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ɗeen ngoni nder fannu Bobo. Ɗoon, leydi ndii ina jogii joomumɓe. On ɗon ndaara Famagan. Ko honɗun woni ɓernde mon?",
     "relecture": "traduction automatique, non relue",
