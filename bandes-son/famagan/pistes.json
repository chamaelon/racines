   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Un jour, il mène sa troupe vers le nord-ouest. La route est longue.",
   "genre": "adulte/homme",
   "duree_ms": 5690,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Wakkati go'o, o yahdi bee jama'aare maako haa woyla hirnaange. Wonaa laawol gootol.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6794,
     "fichier": "famagan-n2-fuf.m4a"
    },
    "mos": {
     "texte": "Daar a ye, a rɩka a tãb-biisã taoore. Yaa sor-kãsenga.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4538,
     "fichier": "famagan-n2-mos.m4a"
    }
