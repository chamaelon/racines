   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Au dix-huitième siècle, Kong est une grande ville de commerce, et de guerre aussi. Famagan Ouattara y dirige des cavaliers.",
   "genre": "adulte/homme",
   "duree_ms": 8500,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Nder karnuwol sappo e joweetati, Kong laati gariiri kuuɓal mawɗo, nden boo nder konu. O'attara mo anndiraaɗo woni ardiiɗo konu.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11354,
     "fichier": "famagan-n1-fuf.m4a"
    },
    "mos": {
     "texte": "Yʋʋm kob-gĩnd piig la a nii wã pʋgẽ, Kong ra yaa tẽn-kãsenga. A Ouattara yʋʋr sẽn boond t'a Maamã zãada so-pakdb n kẽng be.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9594,
     "fichier": "famagan-n1-mos.m4a"
    }
   }
  },
  {
