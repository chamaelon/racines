   "chemin": "nodes.n7.text",
   "noeud": "n7",
   "partie": "Tiéba exige la soumission (jeu)",
   "personnage": "Guimbi Ouattara",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Dis à ton maître que Bobo ne plie pas.",
   "genre": "adulte/femme",
   "duree_ms": 3720,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "I k'a fɔ i kuntigi ye ko Bobo tɛ sɔn ka biri.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4032,
     "fichier": "guimbi-n7-dyu.m4a"
    },
    "fuf": {
     "texte": "Yeccu joomiraawo ma, Bobo ɗon moƴƴaay.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2688,
     "fichier": "guimbi-n7-fuf.m4a"
    }
   }
  },
  {
   "id": "n8",
   "type": "replique",
   "chemin": "nodes.n8.text",
   "noeud": "n8",
   "partie": "Tiéba exige la soumission (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Silence dans la cour. Chacun sait ce que veut dire ce refus. Où vas-tu te placer ? Le récit, lui, restera le même.",
   "genre": "adulte/homme",
   "duree_ms": 10240,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Mɔgɔ si kana kuma kɛnɛma. Mɔgɔ bɛɛ b'a lɔn ko n'u banna, o kɔrɔ ye min ye. I bena taga yɔrɔ jumɛn? Nka, Bibulu ka maana tɛna yɛlɛma.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12110,
     "fichier": "guimbi-n8-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɗuum e nder suudu. Gooto fuu anndi ko jaɓugo ɗum firti. Toye a laato hoore ma? Ko ɗum waɗi boo, haala ma'a ɗon haa foroy.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9902,
     "fichier": "guimbi-n8-fuf.m4a"
    }
