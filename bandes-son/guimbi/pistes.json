   "noeud": "n6",
   "partie": "Tiéba exige la soumission (jeu)",
   "personnage": "L'envoyé de Tiéba",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Tiéba exige ta soumission.",
   "genre": "adulte/homme",
   "duree_ms": 1820,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Tiba b'a fɛ i k'i yɛrɛ majigi.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2064,
     "fichier": "guimbi-n6-dyu.m4a"
    },
    "fuf": {
     "texte": "Tieba e yiɗi a ɗowtana mo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2432,
     "fichier": "guimbi-n6-fuf.m4a"
    }
