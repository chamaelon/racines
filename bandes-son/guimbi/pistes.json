  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Sya, à la fin du XIXe siècle (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Fin du dix-neuvième siècle. Sya, que l'on appelle aujourd'hui Bobo-Dioulasso. Une femme y compte plus que beaucoup d'hommes.",
   "genre": "adulte/homme",
   "duree_ms": 7890,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Saan kɛmɛkulu 19nan laban na. Sya, an b'a wele bi ko Bobo-Dioulasso. Muso kelen lo kɔrɔtanin lo o koo la ka tɛmɛ cɛɛ caaman kan.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10596,
     "fichier": "guimbi-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɓaawo karnijum 19th Sya, biyeteeɗo Bobo-Dioulasso hannde. Debbo ɓuri worɓe ɗuuɗɓe.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6378,
     "fichier": "guimbi-n1-fuf.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Sya, à la fin du XIXe siècle (jeu)",
   "personnage": "Guimbi Ouattara",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Vous partagerez ce champ, et chacun gardera sa part.",
   "genre": "adulte/femme",
   "duree_ms": 3870,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Aw ka kan k'a taran ɲɔgɔn na, mɔgɔ kelen kelen bɛɛ ye a ta yɔrɔ sɔrɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4272,
     "fichier": "guimbi-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "\"Onon yimɓe ɓe'e keɓan ko'e maɓɓe nder lesdi.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3600,
     "fichier": "guimbi-n2-fuf.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Sya, à la fin du XIXe siècle (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "On vient la voir pour régler les disputes, et on l'écoute. Un jour, un explorateur européen arrive à Sya, épuisé.",
   "genre": "adulte/homme",
   "duree_ms": 8650,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "An b'an janto a la walisa ka bɛnbaliyakow ɲɛnabɔ ani k'a lamɛn. Loon dɔ, Erɔpikaw tun be taga Ɛsi jamana na.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9754,
     "fichier": "guimbi-n3-dyu.m4a"
    },
    "fuf": {
     "texte": "Eɗen njahi to maako ngam ɓe cuɓɓa haala maɓɓe, nden kam en keewi mo. Nder nyalnde go'o, tawtoreejo Orop wari to Sya.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8426,
     "fichier": "guimbi-n3-fuf.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Sya, à la fin du XIXe siècle (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Tu dois lui porter ce qu'elle a ordonné. C'est l'accueil dû à un visiteur. Que lui portes-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 7740,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A ye min fɔ, i ka na n'o ye. N'i ye mɔgɔ dɔ weele ka na bɔ i ka soo, o lo b'a to i be se k'o tigi ladon. I be mun le di a ma?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11764,
     "fichier": "guimbi-n4-dyu.m4a"
    },
    "fuf": {
     "texte": "On njaara mo ko o wi'i. Ɗuum woni jaɓɓorgo boowo. Ko honɗun waɗi e makko?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6164,
     "fichier": "guimbi-n4-fuf.m4a"
    }
   }
  },
