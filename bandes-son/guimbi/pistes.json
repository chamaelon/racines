  {
   "id": "rien",
   "type": "replique",
   "chemin": "nodes.rien.text",
   "noeud": "rien",
   "partie": "Sya, à la fin du XIXe siècle (jeu)",
   "personnage": "Guimbi Ouattara",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Ici, l'étranger est sous ma protection. Porte-lui de l'eau et de la cola.",
   "genre": "adulte/femme",
   "duree_ms": 5690,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O yɔrɔ la, n' be lonanw tanga. I ka na ni ji ni kola ye a fɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4970,
     "fichier": "guimbi-rien-dyu.m4a"
    },
    "fuf": {
     "texte": "Haa ɗo, aadiyankeejo ɗon haaje bee am. Hokka mo ndiyam e cola.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5626,
     "fichier": "guimbi-rien-fuf.m4a"
    }
   }
  },
  {
   "id": "bon",
   "type": "replique",
   "chemin": "nodes.bon.text",
   "noeud": "bon",
   "partie": "Le voyageur reçu (jeu)",
   "personnage": "L'explorateur",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Madame, je vous remercie de votre accueil. J'écrirai ce que j'ai vu.",
   "genre": "adulte/homme",
   "duree_ms": 5310,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "N b'a fɛ k'aw fo kosɔbɛ. Ne ye min ye, n bena o sɛbɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4442,
     "fichier": "guimbi-bon-dyu.m4a"
    },
    "fuf": {
     "texte": "Maami, miɗo yetta on ngam jaɓɓorgo mon. Mi winnda ko mi yi'i.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4650,
     "fichier": "guimbi-bon-fuf.m4a"
    }
   }
  },
  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "Le voyageur reçu (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Mais un danger s'approche : Tiéba, le roi de Sikasso, veut étendre son pouvoir. Il envoie un émissaire au galop.",
   "genre": "adulte/homme",
   "duree_ms": 8650,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Nka, faratiba dɔ tun b'a kan: Sikasso masacɛ Teba tun be a fɛ k'a ka fanga bonya. A b'a ka lasigiden dɔ ci ka taga.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10788,
     "fichier": "guimbi-n5-dyu.m4a"
    },
    "fuf": {
     "texte": "Ammaa halleende ɗon ɓadake: Laamiiɗo Sikasso Tieba yiɗi ɓeydude laamu maako. O wurtini goɗɗo nder gariiri.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8164,
     "fichier": "guimbi-n5-fuf.m4a"
    }
   }
  },
  {
