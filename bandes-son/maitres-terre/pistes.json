  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Le maître de la terre (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le Nord est un pays de sable et de vent. La terre n'y donne rien sans raison. Le maître de la terre descend des premiers occupants. Il connaît les autels.",
   "genre": "adulte/homme",
   "duree_ms": 12600,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Sahiliyanfan ye cɛncɛn ni fɔɲɔ ka jamana ye. Dugukolo tɛ foyi di ni kuun t'a la. Dugukolo tigi ye dugutigi fɔlɔw le ye. A b'o sarakabɔyɔrɔw lɔn.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11502,
     "fichier": "maitres-terre-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Kaŋko woni lesdi cembal e yahugo. Luttuɗo lesdi hokkata ɗum ngam daliila goɗɗum. Mawɗo leydi ndii ƴiwoyi daga yimɓe arandeeji. O anndi kuuje ceniiɗe.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12782,
     "fichier": "maitres-terre-n1-fuf.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le maître de la terre (jeu)",
   "personnage": "Le maître de la terre",
   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Terre, reçois ceci, et donne-nous à manger.",
   "genre": "âgé/homme",
   "duree_ms": 3260,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Dugukolo, i ye nin ta k'a di an ma ka domuni kɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3920,
     "fichier": "maitres-terre-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "Duniyaaru, jaɓa ɗum, hokke'en nyaamdu.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2848,
     "fichier": "maitres-terre-n2-fuf.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Le maître de la terre (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il fait l'offrande, et le mil pousse. Un jour, des cavaliers viennent d'ailleurs. Ils s'imposent par la force, et leur chef occupe le village.",
   "genre": "adulte/homme",
   "duree_ms": 10470,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "N'a ye suman di, a be falen. Loon dɔ, sotigi dɔw nana bɔ yɔrɔ wɛrɛ. O bɛ o yɛrɛ majigi ni fanga ye; o ta kuntigiw le bɛ dugu mina.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9998,
     "fichier": "maitres-terre-n3-dyu.m4a"
    },
    "fuf": {
     "texte": "To o hokki ko'e muuɗum, ɓikkoy maako ɓeyi. Nde nyalnde go'oto, yimɓe ɗon njaha dow koyɗe. Ɓe ngaɗata hoore maɓɓe e sembe, laamiiɓe maɓɓe boo ɗon njooɗi gariiri.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11108,
     "fichier": "maitres-terre-n3-fuf.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "La terre refuse (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le chef fait semer ses champs. Mais la terre refuse ses fruits. Rien ne pousse, et ses cavaliers ont faim.",
   "genre": "adulte/homme",
   "duree_ms": 8650,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Kuntigi y'a ka foro sɛnɛ. Nka dugukolo ma den. Fanga t'a la, a ka sotigiw be kɔngɔtɔra.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7796,
     "fichier": "maitres-terre-n4-dyu.m4a"
    },
    "fuf": {
     "texte": "Mawɗo'en ɗon piya gese maako. Ammaa lesdi ɗon nyaamaako. Walaa kooɗume ɗon ɓanngina, e mooli'en maaruɓe nyaamoto.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8692,
     "fichier": "maitres-terre-n4-fuf.m4a"
    }
   }
  },
  {
   "id": "n5",
