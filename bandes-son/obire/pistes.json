   "partie": "La cour du vieux roi (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Mais le roi tousse. Il est fatigué, et tout le monde le voit. Un soir, la nouvelle tombe : le roi est mort.",
   "genre": "adulte/homme",
   "duree_ms": 10090,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Nka, masacɛ tun be kasira. A sɛgɛnnin lo ani mɔgɔ bɛɛ b'a ye. Loon dɔ sufɛ, kibaroya bɔra ko masacɛ sara.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10052,
     "fichier": "obire-n4-dyu.m4a"
    },
    "fuf": {
     "texte": "Ammaa laamiiɗo ɗon nyaama. O marɗo, yimɓe fuu ɗon ndaara mo. Wakkati go'oto nder jemma, ɓe mbi'i: Laamiiɗo maayi.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9358,
     "fichier": "obire-n4-fuf.m4a"
    }
   }
  },
  {
