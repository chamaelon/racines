   "partie": "La cour du vieux roi (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Les tambours l'annoncent. Regarde celui qui porte la nouvelle.",
   "genre": "adulte/homme",
   "duree_ms": 4020,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Dɔnkiliw b'a fɔ an ye ko a bena kɛ ten. A filɛ, mɔgɔ min be kibaro diiman fɔra.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6810,
     "fichier": "obire-n5-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɗu'um ɗon anndina ɗum. Ndaa mo ɗon hokkata haala.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4154,
     "fichier": "obire-n5-fuf.m4a"
    }
