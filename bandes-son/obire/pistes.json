   "partie": "La cour du vieux roi (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "À Obiré, dans le sud-ouest du Burkina, la royauté gan se transmet depuis des générations. Le vieux roi reçoit dans sa cour.",
   "genre": "adulte/homme",
   "duree_ms": 9260,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Obiré dugu la, Burkina Faso worodugu ni tileben fan fɛ. O kɔ, masacɛkɔrɔba ye mɔgɔw ladon a ka luu kɔnɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8634,
     "fichier": "obire-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Haa Obiré, nder worgo hirnaange Burkina, laamu gan ɗon haalde diga duuɓi. Laamiiɗo mawɗo jaɓii nder suudu muuɗum.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9082,
     "fichier": "obire-n1-fuf.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
