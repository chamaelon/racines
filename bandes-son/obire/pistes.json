   "langues": {
    "dyu": {
     "texte": "N'a sɔrɔ a be yɛrɛyɛrɛla, nka dɔrɔ wɛrɛw b'a minɛna.",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "Ɗuum ɓeydaama, ammaa dokke goɗɗe ɗon njaɓɓa ɗum.",
