   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Devant le roi, on s'agenouille. Comment se présente le visiteur ?",
   "genre": "adulte/homme",
   "duree_ms": 4930,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "An b'an kunbiri gwan masacɛ kɔrɔ. Mɔgɔ min nana an ka soo, ale be cogo di?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5562,
     "fichier": "obire-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "E yeeso laamiiɗo, en ɗon njooɗi. Hol no boowo on ɗon wi'i?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4378,
     "fichier": "obire-n2-fuf.m4a"
    }
