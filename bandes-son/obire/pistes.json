   "chemin": "nodes.n6.consigne",
   "texte": "Les tambours annoncent le deuil au pays. Reproduis leur rythme.",
   "langues": {
    "dyu": {
     "texte": "Dɔnkiliw b'a fɔ ko jamana bɛɛ bena kasi. O la, i be se k'u ka fɔta yɛlɛma.",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "Dimbol ɗon anndina yimɓe lesdi. Waɗu ko ɓe mbi'i.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
