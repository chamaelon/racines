   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Dans le sud-ouest du Burkina, de hautes aiguilles de pierre se dressent au-dessus de la plaine. Autrefois, un village senoufo vivait plus au sud, en paix.",
   "genre": "adulte/homme",
   "duree_ms": 10930,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Nder worgo hirnaŋge Burkina, laatooje mawngoje ɗon dari dow ladde. Sahaaji goɗɗi, gariiri senuufu ɗon jooɗoto nder worgo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9258,
     "fichier": "pics-sindou-n1-fuf.m4a"
    },
    "mos": {
     "texte": "Burkĩna soolmã sẽn be zĩ-zãnga wã, roogã pʋgsã yaa kãn-kãe. Pĩnd wẽndẽ, Sinoufo tẽn-tẽng n da be zĩ-gõonegẽ wã, a ra vɩ ne bãane.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11418,
     "fichier": "pics-sindou-n1-mos.m4a"
    }
   }
  },
