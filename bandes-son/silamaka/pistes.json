   "langues": {
    "fuf": {
     "texte": "Mi ɗon wondi bee maaɗa, koo ɗume ko mbi'oton. ",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "Fo sã n leok bũmb ning fãa, mam bee ne foom. ",
