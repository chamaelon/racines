  {
   "id": "finpaye",
   "type": "replique",
   "chemin": "nodes.finpaye.text",
   "noeud": "finpaye",
   "partie": "Le tribut de Ségou (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le campement paie. Il paiera l'an prochain aussi. Dans ce chemin imaginé, il n'y a pas d'épopée, et personne ne chante plus vos noms.",
   "genre": "adulte/homme",
   "duree_ms": 10320,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Kampaango ɗon ceede. O hokkata ceede hitaande toɗɗaaɗe boo. E nder laawol ngol, walaa ko waɗata yimɓe. Walaa koo moye ɓaŋganɗo innde mon.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11038,
     "fichier": "silamaka-finpaye-fuf.m4a"
    },
    "mos": {
     "texte": "Zĩ-kãnga yaooda ligd wʋsgo. A na n yaooda yʋʋmd ning sẽn watã me. Yãmb sẽn na n maan bũmb ningã pʋgẽ, b pa le gomd yãmb yell ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10452,
     "fichier": "silamaka-finpaye-mos.m4a"
    }
   }
