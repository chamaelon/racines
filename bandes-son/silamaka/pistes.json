  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "L'enfant et le serpent (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Silamaka, un héros peul. Et Poullori, son compagnon, à qui rien ne fait peur. Silamaka n'était encore qu'un enfant quand un serpent se dressa devant lui, dans la brousse.",
   "genre": "adulte/homme",
   "duree_ms": 12520,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Silamaama, laamiiɗo mawɗo. E Poullori, gooduɗo maako, mo walaa kulol. Siilaamaama o ɓeydi sukaajo nde hocci dow maako nder lekki.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10388,
     "fichier": "silamaka-n1-fuf.m4a"
    },
    "mos": {
     "texte": "A Silamaka ra yaa nin-soaba. La a Poullori, a tũud-n-taagã sẽn pa yɛɛsd bũmb ye. A Silamãka ra yaa bi-bɩɩga, tɩ kiid n zĩnd a taoore weoogẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12436,
     "fichier": "silamaka-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "L'enfant et le serpent (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il tend la main, et le serpent, au lieu de mordre, s'incline. Il devient son protecteur.",
   "genre": "adulte/homme",
   "duree_ms": 7130,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "O ɓeydi juuɗe maako, ammaa haa o nyaami haykaliiru ndu'u. O laatoto jaɓoowo maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6506,
     "fichier": "silamaka-n2-fuf.m4a"
    },
    "mos": {
     "texte": "A ra tara a nug n kõ-a, la gɩdgã ka sɩɩs-a ye. A lebgda a koglg soaba.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6906,
     "fichier": "silamaka-n2-mos.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Le tribut de Ségou (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Puis vient le roi de Ségou, qui exige un tribut de tous les campements. Ses envoyés arrivent, sûrs d'eux.",
   "genre": "adulte/homme",
   "duree_ms": 8120,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Nden laamiiɗo Ségou wari, o wi'i yimɓe fuu ɓe njaɓa ceede. Wurooɓe maako ngari, ɓe njogii.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7386,
     "fichier": "silamaka-n3-fuf.m4a"
    },
    "mos": {
     "texte": "Rẽ poore, Ségou rĩmã waame n yeel tɩ b segd n yaooda kamb fãa. A tʋm-tʋmdbã waame, n kɩs sɩd ne b mensã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8394,
     "fichier": "silamaka-n3-mos.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Le tribut de Ségou (jeu)",
   "personnage": "L'envoyé de Ségou",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le tribut. Ou l'armée de Ségou viendra le prendre.",
   "genre": "adulte/homme",
   "duree_ms": 4020,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Jaɓɓorgo Ganndal. Walaa boo jama'aare Ségou wari ngam hoɗugo mo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4858,
     "fichier": "silamaka-n4-fuf.m4a"
    },
    "mos": {
     "texte": "Sẽn na yɩl n paam yaoodã. Sã n ka rẽ, a Segou tãb-biisã na n waa n deeg-a lame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5978,
     "fichier": "silamaka-n4-mos.m4a"
    }
   }
  },
  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "Le tribut de Ségou (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Tout le campement se tait. On regarde Silamaka, et il te regarde. Que lui dis-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 7130,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Yimɓe fuu ɗon suuɗa. En ɗon ndaara Silamayaama, o ɗon ndaari ma. Ko honɗun mbi'i mo?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6900,
     "fichier": "silamaka-n5-fuf.m4a"
    },
    "mos": {
     "texte": "Neb nins fãa sẽn da be tãensã roogẽ wã sĩndame. D sã n get a Silamaka, a getda yãmba. Bõe la y yeel-a?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8212,
     "fichier": "silamaka-n5-mos.m4a"
    }
   }
  },
  {
