  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Le temps des fondateurs (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Dans une gorge, à la source du Houet, l'eau tombe en cascade depuis toujours. Sous sa surface vivent de grands poissons moustachus : les silures.",
   "genre": "adulte/homme",
   "duree_ms": 10550,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "K'a ta o wagati ra, ji tun bɛ jigi ka bɔ kɔda dɔ kɔnɔ Houet kɔda ra. O kɔ, u y'a fɔ a ye ko: \"N'i b'a fɛ k'o kɛ, n' be se k'i yɛrɛ tanga o ma\".",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11892,
     "fichier": "silures-dafra-n1-dyu.m4a"
    },
    "mos": {
     "texte": "Kẽer sẽn be Houet kʋɩlgã pʋgẽ wã, koomã ra yaa wa ko-kãseng wakat fãa. Kẽer yaa zĩm-dãmb sẽn tar gãn-kãsemse.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8058,
     "fichier": "silures-dafra-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le temps des fondateurs (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Autour de cette source a grandi Sya, l'ancienne Bobo-Dioulasso. Regarde ce qu'on apporte ici.",
   "genre": "adulte/homme",
   "duree_ms": 6070,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O kɔ, u y'a fɔ a ye ko ale lo tun be yen. A filɛ an be na ni min ye yan.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7322,
     "fichier": "silures-dafra-n2-dyu.m4a"
    },
    "mos": {
     "texte": "Rẽ n so t'a Sya, b sẽn da boond tɩ Bobo-Dioulasso wã bɩtẽ. Ges-y bũmb nins d sẽn wat ne wã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7066,
     "fichier": "silures-dafra-n2-mos.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Le temps des fondateurs (jeu)",
