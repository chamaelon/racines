   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Les jours passent. Les anciens parlent, l'eau ne revient pas. Le pêcheur, loin de là, tombe malade.",
   "genre": "adulte/homme",
   "duree_ms": 7810,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Tilew be tɛmɛ. Cɛkɔrɔbaw bɛ kuma, nka ji tɛ sekɔ. O kɔ, jɛgɛminɛbaga dɔ banana.",
     "relecture": "traduction automatique, non relue",
