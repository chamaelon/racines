     "fichier": "silures-dafra-attendre-dyu.m4a"
    },
    "mos": {
     "texte": "La daarã loogdame. Kãsem-dãmbã gomda, la koomã ka lebgd ye. La zĩm-bi-kãsengã sẽn be zĩig zãra wã, a lebgame tɩ bãad.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10180,
     "fichier": "silures-dafra-attendre-mos.m4a"
    }
   }
