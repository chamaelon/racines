     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2080,
     "fichier": "silures-dafra-n4-dyu.m4a"
    },
    "mos": {
     "texte": "Tẽeg-y y pʋlengã, la y gũ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2000,
     "fichier": "silures-dafra-n4-mos.m4a"
    }
   }
  },
  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "Le temps des fondateurs (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Awa a le cœur lourd. Avant de partir, que laisse-t-elle au bord de l'eau ?",
   "genre": "adulte/homme",
   "duree_ms": 6450,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Awa dusu kasinin lo. Sanni a ka taga, a be mun lo to baji daa la?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6282,
     "fichier": "silures-dafra-n5-dyu.m4a"
    },
    "mos": {
     "texte": "A Awa sũur yaa toog wʋsgo. Sẽn deng a sẽn yi wã, bõe la a bas koomẽ wã?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6698,
