   "type": "replique",
   "chemin": "nodes.n12.text",
   "noeud": "n12",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le pêcheur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Pardonne-moi, gardienne. Je ne savais pas.",
   "genre": "adulte/homme",
   "duree_ms": 3030,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "N'i ka yafa ne ma, garadi. N' tun m'a lɔn.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3674,
     "fichier": "silures-dafra-n12-dyu.m4a"
    },
    "mos": {
     "texte": "Bas-y maam, gũudã. M da pa mi ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3210,
     "fichier": "silures-dafra-n12-mos.m4a"
    }
