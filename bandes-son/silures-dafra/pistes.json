   "duree_ms": 5840,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A be jigɛ bila jii la. A b'o jɛgɛw balo. O kɔ, jii segira ka na.",
     "relecture": "traduction automatique, non relue",
