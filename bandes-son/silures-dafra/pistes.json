  {
   "id": "oubli",
   "type": "replique",
   "chemin": "nodes.oubli.text",
   "noeud": "oubli",
   "partie": "Le temps des fondateurs (jeu)",
   "personnage": "Mah, la gardienne",
   "intonation": "doux",
   "intonation_statut": "proposée",
   "texte": "On n'oublie pas de nourrir ceux qu'on implore. Reviens avec une poignée de nourriture.",
   "genre": "âgée/femme",
   "duree_ms": 5920,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "N'i ye dumuni di mɔgɔ min ma, i hakili b'a la k'o tigi ka ɲi ka dumuni kɛ. N'i kɔsegira n'i ka dumuni ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7914,
     "fichier": "silures-dafra-oubli-dyu.m4a"
    },
    "mos": {
     "texte": "D pa yĩm n na n dɩk neb nins d sẽn kosã ye. Bas-y n wa ne rɩɩb wʋsgo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5210,
     "fichier": "silures-dafra-oubli-mos.m4a"
    }
   }
  },
  {
   "id": "offrande",
   "type": "replique",
   "chemin": "nodes.offrande.text",
   "noeud": "offrande",
   "partie": "Le temps des fondateurs (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Un silure saute hors de l'eau. Le vœu est entendu. Et bientôt, Awa berce son enfant.",
   "genre": "adulte/homme",
   "duree_ms": 7130,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Jigɛ dɔ bɔra jii la. Ala ye layidu min ta, an y'o dafa. Wagati dɔɔni o kɔ, Awa y'a deen suu don.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8068,
     "fichier": "silures-dafra-offrande-dyu.m4a"
    },
    "mos": {
     "texte": "Kẽer n yi koomẽ. B kelg-a lame. La ka la bilfu, Awa rɩka a bi-riblã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7012,
     "fichier": "silures-dafra-offrande-mos.m4a"
    }
   }
  },
  {
   "id": "n6",
   "type": "replique",
   "chemin": "nodes.n6.text",
   "noeud": "n6",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Mais un jour arrive un pêcheur étranger, un harpon sur l'épaule.",
   "genre": "adulte/homme",
   "duree_ms": 4630,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Nka loon dɔ, jɛgɛminɛbaga wɛrɛ nana. A tun b'a kun na ni gɔni ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5898,
     "fichier": "silures-dafra-n6-dyu.m4a"
    },
    "mos": {
     "texte": "La daar a ye, zĩm-biis sẽn da yaa tẽn-zẽmsã waame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5216,
     "fichier": "silures-dafra-n6-mos.m4a"
    }
   }
  },
  {
   "id": "n7",
   "type": "replique",
   "chemin": "nodes.n7.text",
   "noeud": "n7",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Mah, la gardienne",
   "intonation": "doux",
   "intonation_statut": "proposée",
   "texte": "Ici, personne ne pêche. Ces poissons sont sacrés.",
   "genre": "âgée/femme",
   "duree_ms": 3790,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Mɔgɔ si tɛ jɛgɛminɛ kɛ yan. O jɛgɛw ka senu.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4234,
     "fichier": "silures-dafra-n7-dyu.m4a"
    },
    "mos": {
     "texte": "Ka ned sẽn baood zĩm-gãong ye. Rɩt-kãens yaa bõn-sõamyã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4426,
     "fichier": "silures-dafra-n7-mos.m4a"
    }
   }
  },
  {
   "id": "n8",
   "type": "replique",
   "chemin": "nodes.n8.text",
   "noeud": "n8",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le pêcheur",
   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "Des poissons sacrés ! Ils finiront dans ma marmite.",
   "genre": "adulte/homme",
   "duree_ms": 4020,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Jigɛɲumanw! U bena to ne ka daga kɔnɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3418,
     "fichier": "silures-dafra-n8-dyu.m4a"
    },
    "mos": {
     "texte": "Yaa zĩm-sõamyã. B na n kẽnga m pʋ-peemã pʋgẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3866,
     "fichier": "silures-dafra-n8-mos.m4a"
    }
   }
  },
  {
   "id": "n9",
   "type": "replique",
   "chemin": "nodes.n9.text",
   "noeud": "n9",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il lance son harpon, prend un silure et repart, content de lui. Derrière lui, le ciel s'assombrit, et la cascade se tarit goutte après goutte.",
   "genre": "adulte/homme",
   "duree_ms": 10700,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O kɔ, a k'a ta gɔni fiyɛ ka taga. A kɔ fɛ, sankolo kɛra dibi ye, ji jalenw tora ka ja.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8090,
     "fichier": "silures-dafra-n9-dyu.m4a"
    },
    "mos": {
     "texte": "A lobda a tãmbã, n dɩk zĩm n looge, t'a sũur noom ne-a. A Zezi poorẽ, saagã lebga lik la koom-koglgã kʋɩɩga.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9434,
     "fichier": "silures-dafra-n9-mos.m4a"
    }
   }
  },
  {
   "id": "n10",
   "type": "replique",
   "chemin": "nodes.n10.text",
   "noeud": "n10",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "À Sya, les canaris restent vides. Toi qui as tout vu, que fais-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 6220,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Nka, o tɛ foyi ye. Ele min ye koo bɛɛ ye, i be mun le kɛra?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4538,
     "fichier": "silures-dafra-n10-dyu.m4a"
    },
    "mos": {
     "texte": "A Sya pʋgẽ, b pa tar koom-koglgã ye. Fo sẽn yã bũmb nins fãa wã, fo maanda bõe?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7946,
     "fichier": "silures-dafra-n10-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n10.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n10.choices.0.label",
   "texte": "Tu pars chercher le pêcheur",
   "langues": {
    "dyu": {
     "texte": "I ka taga jɛgɛminɛbaga ta",
     "relecture": "traduction automatique, non relue"
    },
