   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Tu le trouves dans son campement, tremblant de fièvre, le silure encore entre ses mains. Il revient avec toi à la gorge.",
   "genre": "adulte/homme",
   "duree_ms": 9260,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "I k'a ye a ta fanibon kɔnɔ, farigban b'a ra ka yɛrɛyɛrɛ; sanbɛrɛ bɛ a boro halibi. A be segi ka na ni i ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9556,
     "fichier": "silures-dafra-chercher-dyu.m4a"
    },
    "mos": {
     "texte": "Fo sã n yãend-a t'a be a logtorẽ wã, a gãnda yĩn-kãnga, la zĩmã ket n bee a nugẽ. A lebg n waa ne yãmba.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8458,
     "fichier": "silures-dafra-chercher-mos.m4a"
    }
   }
