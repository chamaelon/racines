  {
   "id": "seche",
   "type": "replique",
   "chemin": "nodes.seche.text",
   "noeud": "seche",
   "partie": "Le pêcheur étranger (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "On dit qu'en ce temps-là, la soif a vidé bien des cours de Sya, et que chacun a appris trop tard à quoi tenait la source.",
   "genre": "adulte/homme",
   "duree_ms": 10480,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "U b'a fɔ ko o wagati la, minnɔgɔ ye Sya ka lakɔli caaman ban. O kɔ, mɔgɔ bɛɛ sera k'a faamu fɛɛn min kama Ala tun y'o bɔyɔrɔ di u ma.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10698,
     "fichier": "silures-dafra-seche-dyu.m4a"
    },
    "mos": {
     "texte": "B yeelame tɩ wakat kãnga, rã-yũudã kɩtame t'a Sya karen-biis wʋsg lebg zaalem.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
