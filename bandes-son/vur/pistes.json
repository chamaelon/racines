   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Sans preuve, on ne condamne personne. Tu le sais pourtant.",
   "genre": "âgé/homme",
   "duree_ms": 4550,
   "duree_statut": "estimée"
  },
  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "L'ancien te demande de redire ton avis devant tous. Le maintiens-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 5160,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.n5.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n5.choices.0.label",
   "texte": "Non, tu retires ce que tu as dit"
