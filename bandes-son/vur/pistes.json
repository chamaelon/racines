   "duree_ms": 14570,
   "duree_statut": "estimée"
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au matin, le village s'assemble. Un berger de passage arrive.",
   "genre": "adulte/homme",
   "duree_ms": 4550,
   "duree_statut": "estimée"
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le voisin",
   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "C'est lui ! C'est forcément lui !",
   "genre": "adulte/homme",
   "duree_ms": 3260,
   "duree_statut": "estimée"
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Il a beau nier, personne ne l'écoute. Et toi, que dis-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 5460,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.n4.choices.0.label",
