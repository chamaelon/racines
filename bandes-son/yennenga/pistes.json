   "duree_ms": 6600,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "Father, I have fought for you since I was a child. Today I would like a husband and a home.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "nedega2",
   "type": "replique",
   "chemin": "nodes.nedega2.text",
   "noeud": "nedega2",
   "partie": "La cour du roi Nedega (jeu)",
   "personnage": "Naaba Nédega",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Un mari ? Jamais. Ma meilleure guerrière reste auprès de moi.",
   "genre": "adulte/homme",
   "duree_ms": 5080,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "A husband? Never. My best warrior stays by my side.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
