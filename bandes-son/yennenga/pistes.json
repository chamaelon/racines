  {
   "id": "intro",
   "type": "replique",
   "chemin": "nodes.intro.text",
   "noeud": "intro",
   "partie": "La cour du roi Nedega (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Approche, enfant, et tends l'oreille. Ce que je vais te dire, mon père me l'a dit, et son père le lui avait dit avant lui.",
   "genre": "adulte/homme",
   "duree_ms": 10700,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "Come closer, child, and listen well. What I am about to tell you, my father told me, and his father told him before that.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
  {
