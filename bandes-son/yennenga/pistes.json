   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il y a bien longtemps, à Gambaga, au royaume dagomba, régnait le Naaba Nédega. Sa fille Yennenga montait à cheval mieux que tous ses guerriers.",
   "genre": "adulte/homme",
   "duree_ms": 10550,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "Long ago, in Gambaga, in the Dagomba kingdom, reigned Naaba Nedega. His daughter Yennenga rode better than any of his warriors.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
  {
