   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Un jour, un fleuve large leur barre la route : la Volta noire. Comment passer ?",
   "genre": "adulte/homme",
   "duree_ms": 6980,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Loon dɔ, baji belebeleba dɔ tun b'u bali ka taga. I be se ka tɛmɛ cogo di?",
     "relecture": "traduction automatique, non relue",
