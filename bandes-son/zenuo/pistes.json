     "duree_ms": 8036,
     "fichier": "zenuo-rester-dyu.m4a"
    },
    "mos": {
     "texte": "B sõsda wakat fãa. Ned kam fãa sũ-puugrã zãadame, la ned baa a yen ka na n bʋd bõn-buud ye.",
     "relecture": "traduction automatique, non relue",
