   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Ils prennent leurs affaires, et leur chien avec eux. Le soir, ils s'arrêtent près d'un feu et regardent les étoiles.",
   "genre": "adulte/homme",
   "duree_ms": 8500,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "U be taga n'u ka minanw ye. Wuladafɛ, u tun lɔnin be tasuma gɛrɛfɛ ka lolow filɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7530,
     "fichier": "zenuo-partir-dyu.m4a"
    },
    "mos": {
     "texte": "B rɩka b teedã, la b rɩkda b karen-biiga. La yʋngo, b ra bee bugum sɛɛgẽ n get ãdsã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8538,
     "fichier": "zenuo-partir-mos.m4a"
    }
   }
