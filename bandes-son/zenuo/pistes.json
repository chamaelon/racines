   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "Ce champ n'est pas à toi !",
   "genre": "âgé/homme",
   "duree_ms": 2960,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O foro tɛ i ta ye!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
