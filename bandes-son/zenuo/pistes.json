   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Ils discutent toute une saison. Au bout du compte, chacun garde sa colère, et personne n'a plus envie de semer.",
   "genre": "adulte/homme",
   "duree_ms": 8500,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "U be baro kɛra saan kelen kɔnɔ. A laban, mɔgɔ bɛɛ b'a ta jusugban kɔrɔsi; mɔgɔ si t'a fɛ ka siman dan.",
     "relecture": "traduction automatique, non relue",
