   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le courant est trop fort. Ils reviennent sur la rive, trempés, et Zenuo prend sa hache : il creuse une pirogue.",
   "genre": "adulte/homme",
   "duree_ms": 9030,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Jii fanga ka bon kojugu. O sekɔra ka na fɔ bada ra, k'a sɔrɔ o bɛɛ tun sunɔgɔra. Zeno ka a ta wɔrɔsɔ ta; a ka kurun dɔ sogi.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10846,
     "fichier": "zenuo-nage-dyu.m4a"
    },
    "mos": {
     "texte": "Tʋʋmã pãng yaa wʋsgo. B lebg n waa koom-koglgẽ, la a Zenuo rɩka a naandg t'a kogl koom-koakã.",
     "relecture": "traduction automatique, non relue",
