   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Sur l'autre rive, tout est nouveau. Mais où s'arrêter ? Zenuo attend un signe. Observe bien.",
   "genre": "adulte/homme",
   "duree_ms": 7430,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O yɔrɔ la, koo bɛɛ ye kura ye. Nka, an be se ka lɔ yɔrɔ juman? Zenuo be tagamasiyɛn dɔ kɔnɔna. I janto a la koɲuman.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9678,
     "fichier": "zenuo-pirogue-dyu.m4a"
    },
    "mos": {
     "texte": "Tẽngã sẽn be tẽn-zẽngã, bũmb fãa yaa paalga. La zĩ-bʋs la d tõe n bas-a? Zenuo gũuda makre. Ges-y neere.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10078,
     "fichier": "zenuo-pirogue-mos.m4a"
    }
   }
  },
  {
