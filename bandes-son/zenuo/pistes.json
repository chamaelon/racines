   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Encore une dispute de terres. Que décident Zenuo et Nyolé ?",
   "genre": "adulte/homme",
   "duree_ms": 4780,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Fɛɛn dɔw koo la, u ye ɲɔgɔn sɔsɔ tugun. Zenuo ni Nyolé ye mun lo fɔ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
