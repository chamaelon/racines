  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Le trou dans les nuages (jeu)",
   "personnage": "Le griot",
   "intonation": "solennel",
   "intonation_statut": "proposée",
   "texte": "Là-haut, au-dessus des nuages, il y avait un pays d'en haut. Rien n'y manquait. Par un trou dans les nuages, l'ancêtre de Kollo regardait la terre.",
   "genre": "adulte/homme",
   "duree_ms": 11230,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Luttuɗum, dow duule ɗon woodi lesdi daga dow. Walaa kooɗume. Duubaajo Kollo ɗon yi'a duniyaaru nder duule.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8356,
     "fichier": "ancetre-ciel-n1-fuf.m4a"
    },
    "mos": {
     "texte": "Sẽn be yĩngri, sawadg zugẽ, tẽng sẽn yit yĩngri. A ra pa paoog bũmb ye. A Kollo yaab-rãmbã ra getda tẽngã sẽn be sawadg pʋgẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12980,
     "fichier": "ancetre-ciel-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le trou dans les nuages (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Le monde est vide, sans une case et sans une voix. Une corde de lumière se déroule jusqu'au sol. Descendent-ils ?",
   "genre": "adulte/homme",
   "duree_ms": 9030,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Duniyaa ndu walaa goɗɗum, walaa go'o boo walaa wolde. Ɗuum waɗi to duniyaaru. Ɓe ɗon njaha ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7892,
     "fichier": "ancetre-ciel-n2-fuf.m4a"
    },
    "mos": {
     "texte": "Dũniyã yaa zaalem, n ka tar zĩiga la koɛɛg ye. Ninsaalã sẽn da tar vẽenem n be tẽngẽ wã yaa yel-solemde. B na n sigame bɩ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13348,
     "fichier": "ancetre-ciel-n2-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n2.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n2.choices.0.label",
   "texte": "Oui, ils prennent la corde",
   "langues": {
    "fuf": {
     "texte": "Goonga, ɓe ɗon njaɓɓa limce",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "N-ye, b rɩkda pʋga",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
   "id": "nodes.n2.choices.0.tag",
   "type": "parcours",
