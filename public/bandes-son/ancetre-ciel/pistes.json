  {
   "id": "case",
   "type": "replique",
   "chemin": "nodes.case.text",
   "noeud": "case",
   "partie": "La terre vide (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La terre s'effrite entre leurs mains. Sans eau, on ne bâtit rien, et rien n'y poussera.",
   "genre": "adulte/homme",
   "duree_ms": 6980,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Luttuɗum nder juuɗe maɓɓe. To ndiyam walaa, ɗum mahataako.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4698,
     "fichier": "ancetre-ciel-case-fuf.m4a"
    },
    "mos": {
     "texte": "B nugẽ wã, tẽngã paoogdame. Ned sã n ka tar koomã, a pa na n me bũmb ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5514,
