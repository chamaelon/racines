  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "La terre vide (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Les nuages s'ouvrent, et la terre boit enfin. Ils bâtissent une première case ronde, et ils ouvrent un champ. Regarde.",
   "genre": "adulte/homme",
   "duree_ms": 8800,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ɗuum waɗi laana maɓɓiti, duniyaaru boo njari. Ɓe ngaɗi nokkuure wootere nden, ɓe maɓɓiti gese. Ndaa.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7428,
     "fichier": "ancetre-ciel-n3-fuf.m4a"
    },
    "mos": {
     "texte": "La sawadgã pukame, tɩ tẽngã yaool n yũ. B maana raag a yiib-n-soaba, la b tʋlg pʋʋgo. Ges-y-yã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8788,
     "fichier": "ancetre-ciel-n3-mos.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Les premières peintures (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Les années passent, et des enfants naissent. Les femmes prennent de la terre et des pierres de couleur. Que peignent-elles sur les murs ?",
   "genre": "adulte/homme",
   "duree_ms": 10170,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Too, duuɓi keewi, ɓikkoy maayi. Debbo'en ɗon njaɓɓa leydi e kaaƴe nyaamiɗe. Ko honɗun ɓe nganndi dow walluuji ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8740,
     "fichier": "ancetre-ciel-n4-fuf.m4a"
    },
    "mos": {
     "texte": "Yʋʋmã loogdame, la kom-bɩɩsã rogdame. Pagbã rɩka tẽn-gãong la kug buud toor-toorã. Bõe la b gʋlsd wallã zugu?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9140,
     "fichier": "ancetre-ciel-n4-mos.m4a"
    }
   }
