   "personnage": "Son épouse",
   "intonation": "solennel",
   "intonation_statut": "proposée",
   "texte": "Rien n'y bouge. Si personne n'y va, rien n'y bougera jamais.",
   "genre": "adulte/femme",
   "duree_ms": 4930,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Walaa kulol dow maajum. To walaa gooduɗo ton, walaa kooɗume ɗon hoola.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5322,
     "fichier": "ancetre-ciel-regarde-fuf.m4a"
    },
    "mos": {
     "texte": "La bũmb baa a yembr ka yik ye. Ned sã n pa kẽng be, bũmb kõn zĩnd be ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5322,
     "fichier": "ancetre-ciel-regarde-mos.m4a"
    }
   }
  },
  {
   "id": "descend",
   "type": "replique",
   "chemin": "nodes.descend.text",
   "noeud": "descend",
   "partie": "La terre vide (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Longtemps, ils glissent, entre ciel et terre. Une terre vide les attend, là où sera Tiébélé. Le sol est sec. Que faire d'abord ?",
   "genre": "adulte/homme",
   "duree_ms": 10770,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ɗuum waɗi duuɓi ɗuuɗɗi, ɓe njotti hakkunde asama e duniyaaru. Yimɓe ɓe'e nder lesdi ladde, haa nokkuure nde Tibeel woni. Luttuɗum ɗon maaki. Hol ko waɗata arande?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14014,
     "fichier": "ancetre-ciel-descend-fuf.m4a"
    },
    "mos": {
     "texte": "B sẽn be yĩngri ne tẽngã sʋka, b kẽnga zĩig ninga. Tẽnga sẽn ka tar neb n gũud-ba, tɩ Tibɛll na n zĩnda be. Tẽngã yaa kʋɩlenga. Bõe la d segd n maan pipi?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14382,
     "fichier": "ancetre-ciel-descend-mos.m4a"
    }
   }
  },
