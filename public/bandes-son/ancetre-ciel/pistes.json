   "partie": "La terre vide (jeu)",
   "personnage": "L'ancêtre",
   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "Pluie du pays d'en haut, viens à moi !",
   "genre": "voix solennelle/libre",
   "duree_ms": 3870,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Toowe daga lesdi dow, wari haa am!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2416,
     "fichier": "ancetre-ciel-pluie-fuf.m4a"
    },
    "mos": {
     "texte": "Sa-kãseng sẽn yit yĩngri, wa-y mam nengẽ!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3744,
     "fichier": "ancetre-ciel-pluie-mos.m4a"
    }
