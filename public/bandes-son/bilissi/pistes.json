  {
   "id": "cailloux",
   "type": "replique",
   "chemin": "nodes.cailloux.text",
   "noeud": "cailloux",
   "partie": "La nuit du festin (jeu)",
   "personnage": "La femme",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Des cailloux ? Il les sentira à la première bouchée, et il saura qui les a mis. Prends plutôt du piment, et couvre-le de beurre.",
   "genre": "adulte/femme",
   "duree_ms": 10700,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Yala kabakuruw lo? Ni a kɔnna ka o domu tuma min na, a bɛna o ye. A bɛna a lɔn ko jɔn le k'a bla. Nka, i ka pikiri dɔ ta k'a kɛ mugu ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11870,
     "fichier": "bilissi-cailloux-dyu.m4a"
    },
    "fuf": {
     "texte": "Kamɓe ? Nde o fuɗɗi nyaamugo ɗi, o anndi ko waɗi ɗe. Ammaa hoo'u peppere, ɓooyi ɗum bee ƴiiƴam.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8420,
     "fichier": "bilissi-cailloux-fuf.m4a"
