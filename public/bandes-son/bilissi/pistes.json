  {
   "id": "plainte",
   "type": "replique",
   "chemin": "nodes.plainte.text",
   "noeud": "plainte",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Le garde",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Te plaindre ? Encore un mot, et ta bête aussi sera pour lui.",
   "genre": "adulte/homme",
   "duree_ms": 5690,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Yala i b'i yɛrɛ jalaki wa? Ni a ka kuma kelen fɔ tuun, i ta bɛgan fana bɛna kɛ a ta ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6954,
     "fichier": "bilissi-plainte-dyu.m4a"
    },
    "fuf": {
     "texte": "Ma'ajugo? Ɗo'ol wolde go'oto, ngam maajum dabbaaji maaɗa boo keɓan maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6170,
     "fichier": "bilissi-plainte-fuf.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La force ne l'aidera pas. Il faut autre chose.",
   "genre": "adulte/homme",
   "duree_ms": 4020,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Fanga tɛna se k'a dɛmɛ. An mako be fɛɛn wɛrɛ la.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3994,
     "fichier": "bilissi-n4-dyu.m4a"
    },
    "fuf": {
     "texte": "Nguurndam waawataa wallude mo. Ɗu'um ɗon yiɗi feere.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3962,
     "fichier": "bilissi-n4-fuf.m4a"
    }
   }
  },
  {
   "id": "ruse",
   "type": "replique",
   "chemin": "nodes.ruse.text",
   "noeud": "ruse",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Hamadi",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il aime la meilleure part ? Il va l'avoir.",
   "genre": "jeune/homme",
   "duree_ms": 4020,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A b'a fɛ ka koo bɛɛ kɛ a ɲɛɛ na wa? A bena a sɔrɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4586,
     "fichier": "bilissi-ruse-dyu.m4a"
    },
    "fuf": {
     "texte": "O yiɗi ɓurɗum? O heɓan mo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2810,
     "fichier": "bilissi-ruse-fuf.m4a"
    }
   }
  },
  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "La nuit du festin (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Dans la nuit, ils préparent un morceau magnifique. Regarde ce qu'il y a dans la cour.",
   "genre": "adulte/homme",
   "duree_ms": 6830,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Sɔgɔma, u be dumuniba labɛn. A filɛ, fɛɛn min be luu kɔnɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5354,
     "fichier": "bilissi-n5-dyu.m4a"
    },
    "fuf": {
     "texte": "Nder jemma, ɓe mbaɗata kuugal mawnde. Ndaa ko woni nder suudu.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4506,
     "fichier": "bilissi-n5-fuf.m4a"
    }
   }
  },
  {
   "id": "n6",
   "type": "replique",
   "chemin": "nodes.n6.text",
   "noeud": "n6",
   "partie": "La nuit du festin (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Avec quoi Hamadi remplit-il le morceau ?",
   "genre": "adulte/homme",
   "duree_ms": 2960,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Hamadi be mun lo kɛ k'o yɔrɔ fa?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2672,
     "fichier": "bilissi-n6-dyu.m4a"
    },
    "fuf": {
     "texte": "Ko honɗun Hamadi ƴuurata ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2288,
     "fichier": "bilissi-n6-fuf.m4a"
    }
   }
