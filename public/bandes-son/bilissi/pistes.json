   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Depuis, on dit : la part de Bilissi. C'est la part que prend un puissant, sans la mériter.",
   "genre": "adulte/homme",
   "duree_ms": 7890,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Kabi o tuma, u b'a fɔ ko: \"Bilisi ta ye\". Fanga be mɔgɔ min na, o tigi b'o le ta.",
