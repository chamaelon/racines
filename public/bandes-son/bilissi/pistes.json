  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au Macina, autrefois, les troupeaux couvraient la plaine. Ce pays aurait pu être heureux, s'il n'avait pas eu Bilissi.",
   "genre": "adulte/homme",
   "duree_ms": 8270,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Wagati tɛmɛninw na, Makina dugu kɔnɔ, sagaw ni baw tun be to ka mara kɛnɛgbɛ la. Ni Bilisi tun tɛ yen, o jamana tun be se ka kɛ hɛɛrɛ la.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11706,
     "fichier": "bilissi-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Wakkati mawɗi nder lesdi Makina, yimɓe ɓe'e keewi bee leɗɗe. Luttuɗo leydi ndin heɓan belɗum to Bilissi walaa.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9162,
     "fichier": "bilissi-n1-fuf.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Le garde",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La part la plus charnue revient à Bilissi. C'est sa loi.",
   "genre": "adulte/homme",
   "duree_ms": 4780,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A kɛra ten, mɔgɔ minw tun ka kan k'a ta baaraw bɛɛ kɛ, olugu tun ye Bilisi le ye. O ye a ka sariya ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8954,
     "fichier": "bilissi-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "Ammaa ɓurɗo yiite fuu Bilisi. Kanjum woni sariyaaji maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4810,
     "fichier": "bilissi-n2-fuf.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Les troupeaux du Macina (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Les gardes ne laissent presque rien aux familles. Hamadi regarde les enfants de son campement maigrir. Que fait-il ?",
   "genre": "adulte/homme",
   "duree_ms": 8120,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Kɔlɔsilikɛbagaw tɛ foyi to u ka denbayaw ye. Hamadi tun b'a ɲasin a ta mɔgɔw ma, k'a ye ko o ka denmisɛnw fari fagara. A be mun lo kɛra?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12084,
     "fichier": "bilissi-n3-dyu.m4a"
    },
    "fuf": {
     "texte": "Gardiiɓe ɗon acca ko'e maɓɓe. Hamadi ɗon yi'a ɓikkoy nder suudu maako ɓe mbaɗi nyaamo. Hol ko o waɗi?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8996,
     "fichier": "bilissi-n3-fuf.m4a"
    }
   }
  },
  {
   "id": "nodes.n3.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n3.choices.0.label",
   "texte": "Il réfléchit à une ruse",
   "langues": {
    "dyu": {
     "texte": "A ye fɛɛrɛ dɔ ɲini",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "O ɗon ɗaɓɓa laawol",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
