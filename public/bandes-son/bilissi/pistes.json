     "statut": "enregistre",
     "duree_ms": 15230,
     "fichier": "bilissi-n12-dyu.m4a"
    },
    "fuf": {
     "texte": "Bilissi nyaami mo nder wakkati go'o, ammaa o maayi. Peppi ! O ɓooyli, o jippini, o boowi. Bana nde fuɗɗoode, yimɓe fuu mbaɗi mo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10782,
     "fichier": "bilissi-n12-fuf.m4a"
    }
