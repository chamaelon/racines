   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "Écoutez ! Un messie viendra. Le pouvoir des Blancs prendra fin.",
   "genre": "âgé/homme",
   "duree_ms": 5080,
   "duree_statut": "estimée"
  },
  {
