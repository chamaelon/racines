   "noeud": "n3",
   "partie": "1915 à Datomon (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Un prédicateur parle chaque jour devant la mosquée. La foule l'écoute et commence à espérer. Et toi, tu restes l'écouter, ou tu vas voir ce qui se passe plus loin ?",
   "genre": "adulte/homme",
   "duree_ms": 12980,
   "duree_statut": "estimée"
  },
  {
