  {
   "id": "n11",
   "type": "replique",
   "chemin": "nodes.n11.text",
   "noeud": "n11",
   "partie": "La ligne d'arrivée (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Juste avant la ligne, la gazelle s'arrête pour se moquer de la piste vide. Alors tu sautes de son dos, et tu franchis la ligne. Toute la brousse éclate de rire.",
   "genre": "adulte/homme",
   "duree_ms": 12980,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "Just before the line, the gazelle stops to mock the empty track. Then you jump from her back and cross the line. The whole bush bursts out laughing.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "n12",
   "type": "replique",
   "chemin": "nodes.n12.text",
   "noeud": "n12",
   "partie": "La ligne d'arrivée (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Pour la première fois, elle pleure. Ses larmes de honte laissent deux traits noirs sur son museau, et ils ne partent plus.",
   "genre": "adulte/homme",
   "duree_ms": 9260,
   "duree_statut": "estimée",
   "langues": {
    "en": {
     "texte": "For the first time, she weeps. Her tears of shame leave two black stripes on her muzzle, and they never fade.",
     "relecture": "traduction de travail, à relire",
     "statut": "a_enregistrer"
    }
   }
  },
