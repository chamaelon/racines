   "partie": "Film d'animation, de 01:10.0 à 01:16.1",
   "horodatage": {
    "debut_ms": 70000,
    "fin_ms": 76100
   },
   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Derrière les arbres, des kontomblé, les génies de la brousse, frappaient sur des lames de bois.",
