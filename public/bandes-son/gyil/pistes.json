   },
   "personnage": "Narrateur",
   "intonation": "malicieux",
   "intonation_statut": "scénario",
   "texte": "Le gyil des génies. Une légende dagara.",
   "genre": "adulte/libre",
   "duree_ms": 4200,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "O ɗon wi'a ko o woni. Fedde dagara.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "Yaa yel-wẽn-maandb kʋʋdã. Yaa Dagara lagem-n-taar.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "film-002",
   "type": "film",
   "partie": "Film d'animation, de 00:09.0 à 00:17.1",
   "horodatage": {
    "debut_ms": 9000,
    "fin_ms": 17100
   },
   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Autrefois, les villages dagara n'avaient pas de gyil. Les fêtes étaient bien tristes : on se regardait, et on s'ennuyait.",
   "genre": "adulte/libre",
   "duree_ms": 8100,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Wakkati naane, gure dagara'en mbaawataa haayri. Nyalnde nden e woodi ɓernde kalluɗum. Yimɓe ɗon ngi'a hakkunde maɓɓe, ɓe ngaɗata ko wooɗi.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "Pĩnd wẽndẽ, dagara tẽn-tẽnsã ra pa tar kʋʋdb ye. La kibsã ra yaa sũ-sãangre, tɩ nebã ra get taab la b basd taaba.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "film-003",
   "type": "film",
   "partie": "Film d'animation, de 00:30.0 à 00:35.1",
   "horodatage": {
    "debut_ms": 30000,
    "fin_ms": 35100
   },
   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Un jour, Bayuo, un chasseur, s'éloigna trop dans la brousse.",
   "genre": "adulte/libre",
   "duree_ms": 5100,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Go'o go'o Bayuo, mawɗo geɗal, ɓeydi haa nder leɗɗe.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "Daar a ye, Bayuo sẽn da yaa zĩ-yũudd n kẽed weoogẽ wã n loogame.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "film-004",
   "type": "film",
   "partie": "Film d'animation, de 00:42.0 à 00:45.8",
