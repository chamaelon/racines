     "texte": "Juŋŋgo maaɗa njooɗi koo ɗume.",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "Fo nugã zãmsa bũmb fãa.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
