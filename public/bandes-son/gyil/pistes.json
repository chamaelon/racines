    "fin_ms": 87500
   },
   "personnage": "Narrateur",
   "intonation": "émerveillé",
   "intonation_statut": "scénario",
   "texte": "Bayuo oublia sa peur. Il n'avait jamais rien entendu d'aussi beau.",
   "genre": "adulte/libre",
   "duree_ms": 5500,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Bayuo yejjiti kulol muuɗum. O meeɗaay nanugo ko ɓuri wooɗugo.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "A Bayuo basa rabeem ning a sẽn da tarã. A ra zɩ n wʋm bũmb sẽn yaa sõma woto ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
