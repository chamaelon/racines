   "duree_ms": 6100,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Ɓaawo leɗɗe, ruuhuuji nder ladde ɗon mbaroyi lekki.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "La tɩɩsã poore, zĩn-dãmbã ra wẽeda tɩɩgã.",
