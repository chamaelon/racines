   "id": "fuite",
   "type": "replique",
   "chemin": "nodes.fuite.text",
   "noeud": "fuite",
   "partie": "La musique des kontomblé (jeu)",
   "personnage": "Le griot",
   "intonation": "mystérieux",
   "intonation_statut": "proposée",
   "texte": "Il rentre au matin, et il essaie de raconter ce qu'il a entendu. Personne ne le croit. Les fêtes restent tristes, et lui reste avec un air qu'il ne sait plus retrouver.",
   "genre": "adulte/homme",
   "duree_ms": 13360,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "O warti haa jemmaare, o ɗaɓɓi haala maako. Walaa gooduɗo nuɗɗinki. Yimɓe boo ɓe ngalaa hakkiilo, nden kam o ɗon mbaawa yi'ugo ko'e maɓɓe.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11060,
     "fichier": "gyil-fuite-fuf.m4a"
    },
    "mos": {
     "texte": "A waame n na n togs nebã bũmb nins a sẽn wʋmã. Ned pa tẽed-a ye. Tẽegrã ket n yaa sũ-sãanga, t'a pa le tõe n yãend a meng ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10324,
     "fichier": "gyil-fuite-mos.m4a"
    }
   }
  },
  {
   "id": "ecoute",
   "type": "replique",
   "chemin": "nodes.ecoute.text",
   "noeud": "ecoute",
   "partie": "La musique des kontomblé (jeu)",
   "personnage": "Le griot",
   "intonation": "mystérieux",
   "intonation_statut": "proposée",
   "texte": "Il revient la nuit suivante, et la suivante encore. Ses mains, dans le vide, imitent les génies. À toi : retiens l'air.",
   "genre": "adulte/homme",
   "duree_ms": 9860,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "O warti jemma go'o, nden boo jemma gaɗa. Hannde maako boo, nder meere, nandi bee jinnaaɓe. To maaɗa: njooɗee.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9086,
     "fichier": "gyil-ecoute-fuf.m4a"
    },
    "mos": {
     "texte": "A lebg n waame yʋngo, t'a leb n wa. A nusã sẽn pa tar bũmbã wõnda zĩn-dãmbã. La f sã n wa tar-a, bɩ f gãneg f menga.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10484,
     "fichier": "gyil-ecoute-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n4.consigne",
   "type": "jeu",
   "chemin": "nodes.n4.consigne",
   "texte": "Écoute les lames des génies, et reproduis l'air.",
   "langues": {
    "fuf": {
     "texte": "Njaɓee ko jannaaɓe mbi'i, nden ngaɗee ndiyam.",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "Kelg-y yel-bũndbã sẽn gomd bũmb ningã, la y rɩkd yĩngrã.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
