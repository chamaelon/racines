   "partie": "La musique des kontomblé (jeu)",
   "personnage": "Le génie",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Tu mens : cela fait trois nuits que tes mains bougent derrière cet arbre. Qu'as-tu à offrir ?",
   "genre": "voix de génie/libre",
   "duree_ms": 7590,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "On ɗon fewra, ngam nyalɗe joweego'en njooɗoto dow leggal ngol. Ko honɗun hokkata?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6138,
     "fichier": "gyil-perdu-fuf.m4a"
    },
    "mos": {
     "texte": "Yãmb zãmbda: yãmb rɩka tɩɩgã zug yʋng a tãab masã. Bõe la y tõe n kõ-yã?",
