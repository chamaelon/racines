   },
   "personnage": "Narrateur",
   "intonation": "chuchoté",
   "intonation_statut": "scénario",
   "texte": "Il revint la nuit suivante, et la suivante encore, caché derrière un arbre.",
   "genre": "adulte/libre",
   "duree_ms": 5500,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "O warti haa jemma, nden kam o ɓoydi dow leggal.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "A waame yʋngo, t'a leb n solg-a-la tɩɩgã poorẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "film-009",
   "type": "film",
   "partie": "Film d'animation, de 01:52.0 à 01:58.7",
   "horodatage": {
    "debut_ms": 112000,
    "fin_ms": 118700
   },
   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La lune changeait de place. Et ses mains, dans le vide, imitaient de mieux en mieux les génies.",
   "genre": "adulte/libre",
   "duree_ms": 6700,
   "duree_statut": "mesurée sur le film",
