   "personnage": "Le griot",
   "intonation": "mystérieux",
   "intonation_statut": "proposée",
   "texte": "Les génies se regardent. Puis ils lui tendent les baguettes. Bayuo joue. Il a tout retenu. Regarde ce qu'il tient.",
   "genre": "adulte/homme",
   "duree_ms": 9100,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Genius'en ɗon ndaara bee maɓɓe. Caggal ɗum, ɓe ndilli e makko. Bayuo ɗon mooɓta. O hoo'i koo ɗume. Ndaa ko o woodi.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10680,
     "fichier": "gyil-biere-fuf.m4a"
    },
    "mos": {
     "texte": "Vʋʋsem dãmbã getda taaba. Rẽ poore, b kõ-a lame. A Bayuo yɩɩla. A rɩka bũmba fãa. Ges-y bũmb ning a sẽn tarã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11160,
     "fichier": "gyil-biere-mos.m4a"
    }
   }
