  {
   "id": "garde",
   "type": "replique",
   "chemin": "nodes.garde.text",
   "noeud": "garde",
   "partie": "Le retour de Bayuo (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Il joue seul, et il vend ses notes. Un soir, ses lames sonnent faux. Les génies avaient dit : partage. Dans ce chemin imaginé, le gyil se tait.",
   "genre": "adulte/homme",
   "duree_ms": 12440,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "O ɗon jooɗa bee hoore maako, o ɗon feere kuuje maako. Nder jemma go'o, kuuje maako ɗon maaro. Genius'en mbi'i: \"Ndaa\". E nder laawol ngol fooyre, moodiyanke'en ɗon suuɗa.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14152,
     "fichier": "gyil-garde-fuf.m4a"
    },
    "mos": {
     "texte": "A yɩɩla a yembre, la a koosda b notã. Daar a ye yʋngo, yɩɩl nins a sẽn gʋlsã ra pa sɩd ye. Neb nins sẽn da yaa bãngdba ra yeelame tɩ d segd n pʋɩta taaba. Sẽn na yɩl n tõog-b tɩ b bãng b sẽn tõe n maan to-to wã, ned sã n wa kʋ-a, a sĩnddame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 20542,
     "fichier": "gyil-garde-mos.m4a"
    }
   }
  },
  {
   "id": "partage",
   "type": "replique",
   "chemin": "nodes.partage.text",
   "noeud": "partage",
   "partie": "Le premier gyil (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Il taille les lames et y accroche des calebasses. Dès les premières notes, les pieds se mettent à bouger, et tout le village danse.",
   "genre": "adulte/homme",
   "duree_ms": 10020,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "O taƴi gacce ɗe, o hokki boobooje. Nde ɓe nganndi, koyɗe mum'en fuɗɗii ɓamtude, yimɓe wuro ngoo fuu njanngini.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7546,
     "fichier": "gyil-partage-fuf.m4a"
    },
    "mos": {
     "texte": "A kẽesa b sʋʋsã, la a gãnegda a tãb-biisi. La b sẽn wa n yãendẽ wã, b yikame tɩ tẽn-kãng nebã fãa yɩɩ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10746,
     "fichier": "gyil-partage-mos.m4a"
    }
   }
  },
  {
   "id": "n11",
   "type": "replique",
   "chemin": "nodes.n11.text",
   "noeud": "n11",
   "partie": "Le premier gyil (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Depuis, le gyil accompagne les Dagara dans les fêtes, et aussi dans le deuil. Il accompagne la vie et la mort.",
   "genre": "adulte/homme",
   "duree_ms": 8880,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Diga saa'i maajum, Muritanko'en ɗon yahda bee Dagara'en nder juulde e boo nder rewo. O ɗon yahda bee mayde e yonki.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8714,
     "fichier": "gyil-n11-fuf.m4a"
    },
    "mos": {
     "texte": "Rẽ n so t'a sɩnga Dagara rãmbã tɩ b maand kibsã, la b maan sũ-sãoong me. Yaa vɩɩm la kũum sʋka.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8586,
     "fichier": "gyil-n11-mos.m4a"
    }
   }
  },
  {
   "id": "film-001",
   "type": "film",
   "partie": "Film d'animation, de 00:02.0 à 00:06.2",
   "horodatage": {
