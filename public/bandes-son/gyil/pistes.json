    "fin_ms": 45800
   },
   "personnage": "Narrateur",
   "intonation": "inquiet",
   "intonation_statut": "scénario",
   "texte": "La nuit tomba, et il ne retrouva plus son chemin.",
   "genre": "adulte/libre",
   "duree_ms": 3800,
   "duree_statut": "mesurée sur le film",
   "langues": {
    "fuf": {
     "texte": "Nde jemma waɗi, o yi'i laawol.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    },
    "mos": {
     "texte": "Zĩigã lebga yʋngo, t'a ra pa le tõe n paam a sor ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
    }
   }
  },
  {
   "id": "film-005",
   "type": "film",
   "partie": "Film d'animation, de 01:00.0 à 01:03.8",
   "horodatage": {
