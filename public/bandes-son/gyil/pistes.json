   "duree_ms": 4700,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Bayuo ɗon wara. O jogii jawdi. Hol ko o waɗi?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4372,
     "fichier": "gyil-n10-fuf.m4a"
    },
    "mos": {
     "texte": "A Bayuo waa be. A tara arzɛk wʋsgo. A maanda wãna?",
