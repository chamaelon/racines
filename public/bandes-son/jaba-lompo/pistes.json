   "partie": "Le cheval blanc (jeu)",
   "personnage": "Le griot",
   "intonation": "solennel",
   "intonation_statut": "proposée",
   "texte": "Celle que voici n'est pas la seule. Écoute-la comme on écoute un voisin.",
   "genre": "adulte/homme",
   "duree_ms": 5540,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ammaa gooduɗo ɗo'o tan walaa. Njaŋge no njaŋganirɗon ɓerɗe mooɗon.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5722,
     "fichier": "jaba-lompo-n2-fuf.m4a"
    },
    "mos": {
     "texte": "La pa a yembr bal n be woto ye. D kelgd-a-la wa d sẽn kelgd d yagengã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4698,
     "fichier": "jaba-lompo-n2-mos.m4a"
    }
