   "personnage": "Le griot",
   "intonation": "solennel",
   "intonation_statut": "proposée",
   "texte": "Les traditions ne s'accordent pas sur l'origine des Gulmancé. Selon l'une d'elles, Jaba Lompo descendit du ciel sur un cheval blanc, au treizième siècle.",
   "genre": "adulte/homme",
   "duree_ms": 10020,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Aadaaji feere-feere dow ko Gulmance'en fuɗɗii. Gooto nder maɓɓe wi'i Jaba Lompo wari diga asama dow kawal weelo, nder karnuuji 13th.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9818,
     "fichier": "jaba-lompo-n1-fuf.m4a"
    },
    "mos": {
     "texte": "Gullmanse rãmbã sẽn yi zĩig ningã pa zemsd taab ye. A yembr yeelame t'a Jaba Lompo yii saasẽ n kẽed wed-bil sẽn yaa pemse, yʋʋm kob-gĩnd 13 soabã pʋgẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13690,
     "fichier": "jaba-lompo-n1-mos.m4a"
    }
   }
  },
  {
