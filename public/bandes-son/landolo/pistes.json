     "fichier": "landolo-part-dyu.m4a"
    },
    "fuf": {
     "texte": "To walaa mo wallinanɗum, lekki ɗon maaya. Sey weelo mawɗo wari, walaa ɓikkoy nyaamdu. Ɗuum laawol naa' ngol kaalanngal.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8500,
     "fichier": "landolo-part-fuf.m4a"
