   "id": "part",
   "type": "replique",
   "chemin": "nodes.part.text",
   "noeud": "part",
   "partie": "La marâtre espionne (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Sans personne pour le défendre, l'arbre tombe. Vient la grande sécheresse, et il n'y a plus de fruits pour personne. Ce chemin n'est pas celui du conte.",
   "genre": "adulte/homme",
   "duree_ms": 11460,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Ni mɔgɔ si ma sɔrɔ k'a tanga, yiri benna. Sanjiba nana ben, fɔ siman tɛna sɔrɔ mɔgɔ si fɛ tuun. O sira tɛ ele ka maana ye.",
     "relecture": "traduction automatique, non relue",
