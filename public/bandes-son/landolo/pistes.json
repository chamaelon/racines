   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Et l'arbre s'apaise, pour lui. Vient l'année de la grande sécheresse. Tout meurt, sauf le caïlcédrat, dont les fruits nourrissent le village.",
   "genre": "adulte/homme",
   "duree_ms": 9710,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O y'a to yiri nin tun be sumana. Sanjiba san bɛ nana. Fɛɛn bɛɛ be sa, fɔɔ yiriba min deen b'a to dugumɔgɔw be balo.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9444,
     "fichier": "landolo-n8-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɗuum waɗi haa leggal ngal laaɓti. O ɗon wara nder hitaande weelo mawɗo. Koo ɗume ɗon maaya, sey leɗɗe mawɗe ɗe nyaaman gariiri ndin.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10148,
     "fichier": "landolo-n8-fuf.m4a"
    }
