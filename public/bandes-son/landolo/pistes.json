   "noeud": "n7",
   "partie": "La marâtre espionne (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Elle revient avec deux bûcherons. Les coups de hache rebondissent sur le tronc. L'arbre gronde, le vent se lève, les branches fouettent l'air. Que fait Landolo ?",
   "genre": "adulte/homme",
   "duree_ms": 11760,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A kɔsegira ni yiribaarabaga fila ye. O y'a sɔrɔ a tun b'a fɛ k'o kɛ. Yiri bɛ yuguyugu, fɔɲɔ b'a lawuri; a yiriborow bɛ fiyɛ. Landolo be mun lo kɛra?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13368,
     "fichier": "landolo-n7-dyu.m4a"
    },
    "fuf": {
     "texte": "O wurtinaama e yimɓe ɗiɗo. Ɗu'um ɗon maɓɓa ɓikkoy maako. Le'i ɗon cembiɗa, hendu ɗon umma, sappooji maako ɗon maaki. Hol ko Landolo waɗata?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12174,
