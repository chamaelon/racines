   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au bord du village se dressait un arbre immense, plus vieux que tous les anciens.",
   "genre": "adulte/libre",
   "duree_ms": 5100,
   "duree_statut": "mesurée sur le film",
   "langues": {
