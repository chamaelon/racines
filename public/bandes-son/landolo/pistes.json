  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Le grand caïlcédrat (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au bord du village se dressait un arbre immense, plus vieux que tous les anciens. Landolo était orphelin. Il vivait chez sa marâtre, qui gâtait son propre fils.",
   "genre": "adulte/homme",
   "duree_ms": 11840,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Yirisunba dɔ tun lɔnin bɛ dugu kɛrɛ fɛ; a tun kɔrɔra ka tɛmɛ cɛkɔrɔba tɔw bɛɛ kan. Landolo tun ye falatɔ ye. A tun siginin be a biranmuso fɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11742,
     "fichier": "landolo-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Nder daande gariiri ndin ɗon woodi leggal mawngal, ɓurɗum mawɓe fuu. Landolo wondi ɓiɗɗo gorko. O jooɗii e deerɗiraawo maako, ngam o halki ɓiɗɗo maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11444,
     "fichier": "landolo-n1-fuf.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le grand caïlcédrat (jeu)",
   "personnage": "La marâtre",
   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "Va chercher l'eau. Et vite !",
   "genre": "adulte/femme",
   "duree_ms": 2880,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Taga jii ɲini. Aw ka teliya!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2570,
     "fichier": "landolo-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "Ndaa ndiyam. E ɗon!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2234,
     "fichier": "landolo-n2-fuf.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "La branche qui s'abaisse (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Le fils mange à sa faim. Landolo, lui, n'a rien. Un soir, il vient pleurer au pied du grand caïlcédrat. Une branche s'abaisse, chargée de fruits. Que fait-il ?",
   "genre": "adulte/homme",
   "duree_ms": 13120,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Deen be dumuni kɛ k'a fari fa. Landolo kɔni, foyi t'a fɛ. Loon dɔ sufɛ, a y'a daminɛ ka kasi. A y'a fɔ a ye ko: \"Yiriborow bɛɛ be falen ka den. A be mun lo kɛra?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14066,
     "fichier": "landolo-n3-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɓiɗɗo ɗon nyaama. Landolo boo walaa kooɗume. Nder jemma go'o, o wari e koyɗe kalkadir mawɗo. Fuuɗungol ɗon ɓanngina, ɗon nyaama. Hol ko o waɗi?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11832,
     "fichier": "landolo-n3-fuf.m4a"
    }
   }
  },
  {
   "id": "nodes.n3.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n3.choices.0.label",
   "texte": "Il mange, et il remercie l'arbre",
   "langues": {
    "dyu": {
     "texte": "A ye yiri nin deen dumu ani ka barika la Ala ye",
     "relecture": "traduction automatique, non relue"
    },
