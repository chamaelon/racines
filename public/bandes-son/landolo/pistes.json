   },
   "personnage": "Narrateur",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Landolo était orphelin. Il vivait chez sa marâtre, qui gâtait son propre fils.",
   "genre": "adulte/libre",
   "duree_ms": 5400,
   "duree_statut": "mesurée sur le film",
   "langues": {
