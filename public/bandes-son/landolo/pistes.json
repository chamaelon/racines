   "partie": "La marâtre espionne (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La marâtre finit par s'étonner. Elle le suit et elle l'espionne. L'arbre ne lui envoie que des branches sèches.",
   "genre": "adulte/homme",
   "duree_ms": 8120,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A laban, a bamuso kabakoyara. A be tugu a kɔ ani k'a kɔlɔsili kɛ. Yiri nin y'a bolow dɔrɔn le ci a ma.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8884,
     "fichier": "landolo-n5-dyu.m4a"
    },
    "fuf": {
     "texte": "Ɓaawo maajum, mo'o ɗon hayɗina. O ɗon tokkimo, o ɗowtano mo. Leggal ngal ɗon nelda ɗum lekki njayri.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7732,
     "fichier": "landolo-n5-fuf.m4a"
