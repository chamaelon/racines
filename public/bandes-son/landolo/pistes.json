     "statut": "a_enregistrer"
    },
    "fuf": {
     "texte": "Landolo wondi ɓiɗɗo gorko. O jooɗii e deerɗiraawo maako, ngam o halki ɓiɗɗo maako.",
     "relecture": "traduction automatique, non relue",
     "statut": "a_enregistrer"
