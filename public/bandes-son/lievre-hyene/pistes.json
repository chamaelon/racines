   "type": "replique",
   "chemin": "nodes.partage.text",
   "noeud": "partage",
   "partie": "Le chemin de nuit (jeu)",
   "personnage": "Le lièvre",
   "intonation": "amusé",
   "intonation_statut": "proposée",
   "texte": "Hyène, ta force fait peur, mais elle ne fait pas pousser le mil. Prends une daba : celui qui travaille mange.",
   "genre": "voix de conte/libre",
   "duree_ms": 9030,
   "duree_statut": "estimée"
  },
  {
   "id": "partage2",
   "type": "replique",
   "chemin": "nodes.partage2.text",
   "noeud": "partage2",
   "partie": "Le chemin de nuit (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "On dit qu'ils cultivèrent côte à côte une saison entière. Une saison seulement, car une hyène reste une hyène, mais personne n'eut faim cette année-là.",
   "genre": "adulte/homme",
   "duree_ms": 10400,
   "duree_statut": "estimée"
  },
  {
   "id": "fuite",
   "type": "replique",
   "chemin": "nodes.fuite.text",
   "noeud": "fuite",
   "partie": "Le chemin de nuit (jeu)",
   "personnage": "Le griot",
   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Le lièvre n'attend pas la suite. Il bondit entre les pattes de l'hyène et disparaît dans le noir.",
   "genre": "adulte/homme",
   "duree_ms": 7440,
   "duree_statut": "estimée"
  },
  {
   "id": "fuite2",
   "type": "replique",
   "chemin": "nodes.fuite2.text",
   "noeud": "fuite2",
   "partie": "Le chemin de nuit (jeu)",
   "personnage": "Le griot",
   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Il court encore, dit-on. Et depuis ce temps, le lièvre dort d'un œil.",
   "genre": "adulte/homme",
   "duree_ms": 5840,
   "duree_statut": "estimée"
  },
  {
   "id": "tamtam1",
   "type": "replique",
