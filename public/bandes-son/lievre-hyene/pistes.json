   "partie": "Le chemin de nuit (jeu)",
   "personnage": "Le griot",
   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Un soir, sur le chemin du retour, deux yeux brillent dans le noir.",
   "genre": "adulte/homme",
   "duree_ms": 5540,
   "duree_statut": "estimée"
  },
  {
   "id": "hyene4",
   "type": "replique",
