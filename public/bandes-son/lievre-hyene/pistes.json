   "partie": "Le chemin de nuit (jeu)",
   "personnage": "L'hyène",
   "intonation": "moqueur",
   "intonation_statut": "proposée",
   "texte": "Tu es bien malin, paraît-il. Réponds à ma devinette, ou je te croque.",
   "genre": "voix de conte/libre",
   "duree_ms": 5840,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.devinette.question",
   "type": "jeu",
   "chemin": "nodes.devinette.question",
   "texte": "J'ai une case sans porte ni fenêtre, et pourtant quelqu'un en sortira. Qui suis-je ?"
  },
