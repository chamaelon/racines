   "type": "replique",
   "chemin": "nodes.choix1.text",
   "noeud": "choix1",
   "partie": "La brousse (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Le lièvre est bien petit, et l'hyène a de grandes dents. Que répond-il ?",
   "genre": "adulte/homme",
   "duree_ms": 6070,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.choix1.choices.0.label",
   "type": "choix",
   "chemin": "nodes.choix1.choices.0.label",
   "texte": "« Cultivons un champ ensemble, nous partagerons. »"
  },
  {
   "id": "nodes.choix1.choices.0.tag",
   "type": "parcours",
   "chemin": "nodes.choix1.choices.0.tag",
   "texte": "champ commun"
