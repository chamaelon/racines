   "type": "replique",
   "chemin": "nodes.mil1.text",
   "noeud": "mil1",
   "partie": "Le champ partagé (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "À la récolte, l'hyène emporte tous les épis. Le lièvre n'a que des racines à mâcher : il se promet d'être plus malin l'an prochain.",
   "genre": "adulte/homme",
   "duree_ms": 10400,
   "duree_statut": "estimée"
  },
  {
