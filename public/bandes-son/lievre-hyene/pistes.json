   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Les tam-tams du marché s'emballent. Si le lièvre suit le rythme, la foule dansera autour de lui, et l'hyène ne le trouvera pas tout de suite.",
   "genre": "adulte/homme",
   "duree_ms": 10780,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.tamtam.consigne",
   "type": "jeu",
   "chemin": "nodes.tamtam.consigne",
   "texte": "Écoute le tam-tam, puis reproduis le rythme."
  },
  {
   "id": "nodes.tamtam.gagne",
   "type": "jeu",
   "chemin": "nodes.tamtam.gagne",
   "texte": "La foule danse, le lièvre disparaît au milieu d'elle !"
  },
  {
   "id": "nodes.tamtam.perdu",
   "type": "jeu",
   "chemin": "nodes.tamtam.perdu",
   "texte": "Le rythme s'est perdu, et la foule s'écarte…"
  },
  {
   "id": "nodes.tamtam.tags.win",
   "type": "parcours",
   "chemin": "nodes.tamtam.tags.win",
   "texte": "rythme tenu"
  },
  {
   "id": "nodes.tamtam.tags.lose",
   "type": "parcours",
   "chemin": "nodes.tamtam.tags.lose",
   "texte": "rythme perdu"
  },
  {
   "id": "tamtamOK",
   "type": "replique",
   "chemin": "nodes.tamtamOK.text",
   "noeud": "tamtamOK",
   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Le lièvre gagne un peu de temps. Mais l'hyène a du flair, et elle finit par le retrouver derrière un étal.",
   "genre": "adulte/homme",
   "duree_ms": 8730,
   "duree_statut": "estimée"
