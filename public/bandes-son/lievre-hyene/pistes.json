   "type": "replique",
   "chemin": "nodes.marche1.text",
   "noeud": "marche1",
   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Au marché, on vend, on goûte, on se moque de tout le monde. Regarde ce qu'il y a sur les étals.",
