   "noeud": "hyene3",
   "partie": "Le marché (jeu)",
   "personnage": "L'hyène",
   "intonation": "moqueur",
   "intonation_statut": "proposée",
   "texte": "Cette année, je prends le dessous ! Et ne t'avise pas de me tromper une seconde fois.",
   "genre": "voix de conte/libre",
   "duree_ms": 7210,
   "duree_statut": "estimée"
  },
  {
   "id": "choix3",
   "type": "replique",
   "chemin": "nodes.choix3.text",
   "noeud": "choix3",
   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Une nouvelle saison commence. Que sème le lièvre maintenant que l'hyène a choisi le dessous ?",
   "genre": "adulte/homme",
   "duree_ms": 6680,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.choix3.choices.0.label",
   "type": "choix",
   "chemin": "nodes.choix3.choices.0.label",
   "texte": "Du mil, et elle n'aura que les racines"
