  {
   "id": "tamtamKO",
   "type": "replique",
   "chemin": "nodes.tamtamKO.text",
   "noeud": "tamtamKO",
   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "Le lièvre reste seul au milieu de la place, bien en vue. L'hyène arrive droit sur lui.",
   "genre": "adulte/homme",
