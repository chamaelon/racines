   "partie": "Le champ partagé (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "À la récolte, l'hyène reçoit des brassées de feuilles. Le lièvre, lui, emplit ses paniers de graines.",
   "genre": "adulte/homme",
   "duree_ms": 7510,
   "duree_statut": "estimée"
  },
  {
