  {
   "id": "nodes.choix1.choices.1.label",
   "type": "choix",
   "chemin": "nodes.choix1.choices.1.label",
   "texte": "« Je vais t'apporter mes dernières provisions. »"
  },
  {
   "id": "nodes.choix1.choices.1.tag",
   "type": "parcours",
   "chemin": "nodes.choix1.choices.1.tag",
   "texte": "provisions données"
  },
  {
   "id": "offrande",
   "type": "replique",
   "chemin": "nodes.offrande.text",
   "noeud": "offrande",
   "partie": "La brousse (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le lièvre vide son terrier. L'hyène engloutit tout et revient dès le lendemain, plus affamée encore. Il faut trouver autre chose.",
   "genre": "adulte/homme",
   "duree_ms": 9030,
   "duree_statut": "estimée"
  },
  {
   "id": "accord",
   "type": "replique",
   "chemin": "nodes.accord.text",
   "noeud": "accord",
   "partie": "La brousse (jeu)",
   "personnage": "Le lièvre",
   "intonation": "amusé",
   "intonation_statut": "proposée",
   "texte": "Ensemble, faisons un champ. Je travaille, tu surveilles. À toi ce qui pousse au-dessus de la terre, à moi ce qui pousse au-dessous.",
   "genre": "voix de conte/libre",
   "duree_ms": 10090,
   "duree_statut": "estimée"
  },
  {
   "id": "hyene2",
   "type": "replique",
   "chemin": "nodes.hyene2.text",
   "noeud": "hyene2",
   "partie": "La brousse (jeu)",
   "personnage": "L'hyène",
   "intonation": "moqueur",
   "intonation_statut": "proposée",
   "texte": "Le dessus, c'est là que sont les beaux épis ! J'accepte, et je vais dormir à l'ombre.",
   "genre": "voix de conte/libre",
   "duree_ms": 7360,
   "duree_statut": "estimée"
  },
  {
   "id": "choix2",
   "type": "replique",
   "chemin": "nodes.choix2.text",
   "noeud": "choix2",
   "partie": "Le champ partagé (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "La pluie arrive, c'est le moment de semer. Que sème le lièvre ?",
   "genre": "adulte/homme",
   "duree_ms": 5690,
   "duree_statut": "estimée"
  },
  {
   "id": "nodes.choix2.choices.0.label",
   "type": "choix",
   "chemin": "nodes.choix2.choices.0.label",
   "texte": "Des arachides, qui mûrissent sous la terre"
