   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "L'hyène, vexée, s'en va en ricanant. Le lièvre rentre au village avec ses paniers, et on raconte ses tours à chaque veillée.",
   "genre": "adulte/homme",
   "duree_ms": 9410,
   "duree_statut": "estimée"
  },
  {
   "id": "malice2",
   "type": "replique",
   "chemin": "nodes.malice2.text",
   "noeud": "malice2",
   "partie": "Le retour au village (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La force prend, la malice partage à sa façon : qui ne travaille pas ne choisit pas sa récolte.",
   "genre": "adulte/homme",
   "duree_ms": 7820,
   "duree_statut": "estimée"
  },
  {
