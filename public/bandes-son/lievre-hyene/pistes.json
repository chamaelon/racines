   "type": "parcours",
   "chemin": "nodes.choix3.choices.1.tag",
   "texte": "arachides, deuxième année"
  },
  {
   "id": "mil2",
   "type": "replique",
   "chemin": "nodes.mil2.text",
   "noeud": "mil2",
   "partie": "Le marché (jeu)",
   "personnage": "Le griot",
   "intonation": "joyeux",
   "intonation_statut": "proposée",
   "texte": "L'hyène tire sur les tiges et ne trouve que des racines. Le lièvre, lui, bat ses épis en chantant.",
   "genre": "adulte/homme",
   "duree_ms": 8120,
   "duree_statut": "estimée"
  },
  {
   "id": "arachide2",
