     "duree_ms": 7876,
     "fichier": "liptako-cult-dyu.m4a"
    },
    "mos": {
     "texte": "Bõn-buudã makda bõn-buudu sẽn be yʋʋmdã roogẽ. A sã n ka be, kom na n yõk a zakã rãmba. La pe-kɩɩmã me yaa bõe?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10468,
     "fichier": "liptako-cult-mos.m4a"
