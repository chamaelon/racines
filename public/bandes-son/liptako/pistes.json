   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Le mil, c'est le grenier de l'année. Sans lui, sa famille aura faim. Et le berger ?",
   "genre": "adulte/homme",
   "duree_ms": 7660,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Siman ye san siman ta so le ye. N'o tɛ, kɔngɔ bena a somɔgɔw bɛɛ faga. O sagagbɛnbaga ye mun lo ye?",
     "relecture": "traduction automatique, non relue",
