  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Deux mondes à Dori (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Début du dix-neuvième siècle, dans la région de Dori, au Sahel. Ici vivent deux mondes : les éleveurs peuls avec leurs troupeaux, et les cultivateurs gulmancé avec leurs champs.",
   "genre": "adulte/homme",
   "duree_ms": 12220,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Saan 1900 wagati daminɛ na, Dori mara la Sahɛli jamana na. Jamana fla le bɛ yan: sagadɛndɛbagaw ni o ta bɛganw, ani sɛnɛkɛlaw ni o ka forow.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11940,
     "fichier": "liptako-n1-dyu.m4a"
    },
    "mos": {
     "texte": "Yʋʋm kobs a 19 soabã sɩngrẽ, Dori soolmẽ wã. Yaa neb a yiib n be tẽng zug: pe-kɩɩmb ne b rũmbu, la pʋʋsa rãmb ne b pʋtẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10564,
     "fichier": "liptako-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le troupeau dans le champ (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La terre doit nourrir les uns et les autres. Mais un jour, un troupeau entre dans un champ.",
   "genre": "adulte/homme",
   "duree_ms": 7590,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Dugukolo ka ɲi k'u bɛɛ balo. Nka loon dɔ, u ye sagakulu dɔ kunbɛn foro dɔ la.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6410,
     "fichier": "liptako-n2-dyu.m4a"
    },
    "mos": {
     "texte": "Tẽngã segd n dɩka a taaba. La daar a ye, piisã kẽe weoogẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5674,
     "fichier": "liptako-n2-mos.m4a"
    }
   }
  },
