  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Les cavaliers mossi (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Dans le pays samo, la vie suivait son cours. Jusqu'à ce jour-là, où des cavaliers mossi approchent dans un nuage de poussière.",
   "genre": "adulte/homme",
   "duree_ms": 9260,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Samoa jamana na, mɔgɔw tun be ɲɛnamaya kɛ cogo nɔgɔman na. fɔ ka taga se o lon ma. O lon na, sotigi dɔw bɛna na ni buguri ye sankaba ra.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11668,
     "fichier": "rakire-n1-dyu.m4a"
    },
    "mos": {
     "texte": "Saam-bi-poak sẽn da be Samõ wã, vɩɩmã ra yaa to-to. Hal tɩ ta daar ning b sẽn na n yãt tãb-biis sẽn be bugum pʋgẽ wã.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8986,
     "fichier": "rakire-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Les cavaliers mossi (jeu)",
   "personnage": "Le chef mossi",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Cette terre est désormais à nous.",
