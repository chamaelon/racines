  {
   "id": "rancune",
   "type": "replique",
   "chemin": "nodes.rancune.text",
   "noeud": "rancune",
   "partie": "La nuit des blessés (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Au matin, chacun compte ses morts, et chacun jure de les venger. Trop de sang pour rien. Ce n'est pas la fin que l'on raconte, heureusement.",
   "genre": "adulte/homme",
   "duree_ms": 11230,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O bɛ o mɔgɔ faganinw jate sɔgɔmada joona fɛ, k'a fɔ ko o bɛna wuri o kama. Joli tun ka ca. An be min fɔra, o tɛ laban ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10980,
     "fichier": "rakire-rancune-dyu.m4a"
    },
    "mos": {
     "texte": "Sã n ya rũnna, ned kam fãa getda a nin-buiida la b wẽeneda tɩ b na n sɩbg-b lame. Yaa zɩɩm wʋsg n pa tõe n maan bũmb ye. La sũ-noogo, d sẽn yetã pa baasg ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13812,
     "fichier": "rakire-rancune-mos.m4a"
    }
   }
  },
  {
   "id": "gourde",
   "type": "replique",
   "chemin": "nodes.gourde.text",
   "noeud": "gourde",
   "partie": "La nuit des blessés (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Une femme samo arrive, s'arrête devant un cavalier mossi. Elle hésite, puis elle le soigne.",
   "genre": "adulte/homme",
   "duree_ms": 6600,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Samusɔn muso dɔ nana, a lɔra sotigi dɔ ɲɛfɛ. O kɔ, a y'a janto a la.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 6618,
     "fichier": "rakire-gourde-dyu.m4a"
    },
    "mos": {
     "texte": "Saam-bi-poak a ye waame, t'a zĩndi n na n yãgẽ. A yɛɛsame t'a na n sõng-a lame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7930,
     "fichier": "rakire-gourde-mos.m4a"
    }
   }
  },
  {
   "id": "soin",
   "type": "replique",
   "chemin": "nodes.soin.text",
   "noeud": "soin",
   "partie": "La nuit des blessés (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Un cavalier, à son tour, panse un archer samo. Plus personne ne se souvient du camp de l'autre.",
   "genre": "adulte/homme",
   "duree_ms": 7740,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "O kɔ, a y'a fɔ u ye ko: \"Aw k'aw yɛrɛ majigi. Mɔgɔ si tɛ se k'a hakili to a tɔɲɔgɔn ka sigiyɔrɔ la tugun.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9460,
     "fichier": "rakire-soin-dyu.m4a"
    },
    "mos": {
     "texte": "Sã n yaa ne so-rʋʋda, a sẽbda Samõ nin-tũudu. Ned pa le tẽr a taabã logtoogã ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
