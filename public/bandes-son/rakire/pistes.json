  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Les cavaliers mossi (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le chef samo appelle ses archers. Les flèches contre les chevaux. On se bat toute la journée, et personne ne gagne.",
   "genre": "adulte/homme",
   "duree_ms": 9030,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Jamana kuntigi Samo b'a ka kalanbonbagaw wele. Aw ye biɲɛw ta ka taga soow kama. An ye kɛlɛ kɛ tile bɛɛ, nka mɔgɔ si ma see sɔrɔ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10836,
     "fichier": "rakire-n3-dyu.m4a"
    },
    "mos": {
     "texte": "Saam-bi-poakã boola a zabdbã. Sagls nins sẽn zabd ne wed-rãmbã. Tõnd zabda ne taab daar fãa, la ned baa a yen ka tõogd ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9796,
     "fichier": "rakire-n3-mos.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "La nuit des blessés (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "La nuit tombe. Il ne reste que des blessés, des deux camps, tous abandonnés. Un archer et un cavalier se regardent. L'archer a encore de l'eau. Que fait-il ?",
   "genre": "adulte/homme",
   "duree_ms": 12820,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Suu be ɲini ka don. Mɔgɔ minw mandiminin tora, o bɛɛ bɔra fan fla ra. Sotigi ni kalanbɔbaga be ɲɔgɔn filɛra. Ji bele be kalanbaga fɛ. A be mun lo kɛra?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12552,
     "fichier": "rakire-n4-dyu.m4a"
    },
    "mos": {
     "texte": "Yĩng n beẽ. Sẽn ket-b lame yaa neb nins b sẽn maan kaalem to-to wã bala. B fãa basame. Zĩ-bõonegã ne a soaalã geta taaba. Koɛɛgã ket n tara koomã. A maanda bõe?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14402,
     "fichier": "rakire-n4-mos.m4a"
    }
   }
  },
  {
