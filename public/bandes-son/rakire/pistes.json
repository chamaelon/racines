     "texte": "O bɛɛ n'a ta, a b'a janto a la.",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "La baa ne rẽ fãa, a sakda-a lame.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
