  {
   "id": "garde",
   "type": "replique",
   "chemin": "nodes.garde.text",
   "noeud": "garde",
   "partie": "La nuit des blessés (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Le cavalier gémit toute la nuit. Une femme samo arrive, s'arrête devant lui, hésite. Va-t-elle le soigner ?",
   "genre": "adulte/homme",
   "duree_ms": 8040,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Mɔgɔ min tun yɛlɛnin be soo kan, ale ye kulo suu bɛɛ. Samusɔn muso dɔ nana, a lɔra a kɔrɔ ka sigasigara. Yala a bena o furakɛ wa?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12116,
     "fichier": "rakire-garde-dyu.m4a"
    },
    "mos": {
     "texte": "Sẽn zao-a wã kelemda yʋngo fãa. Saam-bi-poak a ye n wa, t'a na n kẽng n tɩ zĩnd ne-a. A na n gesa a yell bɩ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10036,
     "fichier": "rakire-garde-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.garde.choices.0.label",
   "type": "choix",
   "chemin": "nodes.garde.choices.0.label",
   "texte": "Oui, elle le soigne malgré tout",
   "langues": {
