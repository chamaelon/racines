  {
   "id": "attente",
   "type": "replique",
   "chemin": "nodes.attente.text",
   "noeud": "attente",
   "partie": "La disparition (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Elle ne revient pas. Les soirs de lune, dit-on, quelqu'un danse encore dans la clairière, sans nom et sans village. Tu pourrais recommencer pour changer cela.",
   "genre": "adulte/homme",
   "duree_ms": 11230,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A tɛ kɔsegi. Mɔgɔw b'a fɔ ko kalo sufɛ, mɔgɔ dɔ bɛ to ka dɔnkiri la kɛnɛgbɛ kɔnɔ, tɔgɔ t'a ra, dugumɔgɔw tɛ o yɔrɔ ra. I be se k'a daminɛ kokura walisa k'o yɛlɛma.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14420,
     "fichier": "tene-balafon-attente-dyu.m4a"
    },
    "fuf": {
     "texte": "O warataa. Ɓe mbi'i nder jemmaare lewru, goɗɗo ɗon yiya haa foroy, walaa innde, walaa gariiri. A waawaa fuɗɗitaade ngam waylude ɗum.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10692,
     "fichier": "tene-balafon-attente-fuf.m4a"
    }
   }
  },
  {
   "id": "dozo",
   "type": "replique",
   "chemin": "nodes.dozo.text",
   "noeud": "dozo",
   "partie": "La disparition (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Le maître consulte ses amulettes et lève son chasse-mouche. Les dozo partent avec leur chien. Au loin, la musique revient.",
   "genre": "adulte/homme",
   "duree_ms": 8650,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Matigi bɛ a ta nɛgɛbɛnnanw flɛ, k'a ta sowotorow kɔrɔta. Dozow be taga n'u ka wulu ye. K'a to yɔrɔjan, dɔnkilila be na.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9636,
     "fichier": "tene-balafon-dozo-dyu.m4a"
    },
    "fuf": {
     "texte": "Mawɗo on ɗon ɗaɓɓita kuuje maako, o ɗon ummina kuuje muuɗum. Dozo'en ɗon njaha bee doggi maɓɓe. Nder yaasi, yimɓe ɗon maaro.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9892,
     "fichier": "tene-balafon-dozo-fuf.m4a"
    }
   }
  },
  {
   "id": "nodes.n6.consigne",
   "type": "jeu",
   "chemin": "nodes.n6.consigne",
   "texte": "Retiens l'air des génies pour guider le chien jusqu'à la clairière.",
   "langues": {
    "dyu": {
     "texte": "N'i b'a fɛ k'i ka wuluw sama ka taga n'u ye kɛnɛma.",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "Hokka ɓeynguure ɓerɗe ngam yahugo dogol haa le'i.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
   "id": "nodes.n6.gagne",
   "type": "jeu",
   "chemin": "nodes.n6.gagne",
   "texte": "Le chien lève la tête et file droit : vous tenez la bonne direction.",
   "langues": {
    "dyu": {
     "texte": "Wuluw b'u kun kɔrɔta ka taga ɲafɛ. Aw be siraɲuman kan.",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "Mbira ƴetti hoore maako, o ɗon yaha haa yaasi: on ɗon hoola laawol.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
   "id": "nodes.n6.perdu",
   "type": "jeu",
   "chemin": "nodes.n6.perdu",
   "texte": "Vous tournez un moment, puis le chien retrouve la piste.",
   "langues": {
    "dyu": {
     "texte": "N'i ye filɛli kɛ wagati dɔ la, o kɔ, i be se k'a yira a la.",
     "relecture": "traduction automatique, non relue"
    },
    "fuf": {
     "texte": "On njogii gootol, nden boo dogol heɓan laawol.",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
