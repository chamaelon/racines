   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "A bɛ tagama fɔ ka taga dugu gbɛ; a bɛ kule, nka dɔnkiri dɔrɔn le b'a jaabi. A sɛgɛnin lo. An ka ɲi k'o kɛ suu kelen dɔrɔn.",
