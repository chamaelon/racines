   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Le soir, au village, le vieux Ziè jouait du balafon. Et Téné dansait. Regarde l'instrument.",
   "genre": "adulte/homme",
   "duree_ms": 6900,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Sɔgɔma wulafɛ, Ziè tun be balafɔni kɛra dugu kɔnɔ. O kɔ, Téné tun be dansi kɛra. A filɛ o fɔlifɛn ye min ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 10724,
     "fichier": "tene-balafon-n1-dyu.m4a"
    },
    "fuf": {
     "texte": "Nder jemma nder gariiri, Ziè mawɗo ɗon mooɓta balafon. Téné boo ɗon yaha. Ndaa kuugal ngal.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7716,
     "fichier": "tene-balafon-n1-fuf.m4a"
