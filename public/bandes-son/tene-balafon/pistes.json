   "duree_ms": 10700,
   "duree_statut": "estimée",
   "langues": {
    "dyu": {
     "texte": "Lon dɔ su fɛ, dɔnkiri wɛrɛ bɔra yiritunin kɔnɔ; a ka ɲi ni Zi ta ye. Téné be wuli ni mankan tɛ. A be taga mankan fɛ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 9582,
     "fichier": "tene-balafon-n2-dyu.m4a"
    },
    "fuf": {
     "texte": "Nder jemma go'oto, yiite ɓurɗo yiite Si'a ɗon wurta nder leɗɗe. Téné ɗon ummitoo ngam walaa ko waawata. O ɗon yahda to waawde.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8996,
     "fichier": "tene-balafon-n2-fuf.m4a"
