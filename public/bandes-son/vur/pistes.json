     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "Pa rẽ ye, bɩ f bas bũmb ning fo sẽn yeelã",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
   "id": "nodes.n5.choices.0.tag",
