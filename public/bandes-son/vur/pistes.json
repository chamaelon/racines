   "duree_ms": 12900,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Wakkati go'o, sukaajo mo ɗon ɗaani. Kanko woni jaɓɓi miliyaar. Wakkati go'oto, o wurtini ceede maako haa dammugal suudu. Ammaa Ebéyé ɗon.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 11902,
     "fichier": "vur-reste-fuf.m4a"
    },
    "mos": {
     "texte": "Vʋʋsem a yiib-n-soabã, bi-bɩɩg a ye ra pa tol n gõe ye. A rɩka koodã. Daar a ye yʋngo, a lebg n waa ne bugum roogẽ wã. La a Ebéyé beeme.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 14110,
     "fichier": "vur-reste-mos.m4a"
    }
