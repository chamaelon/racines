  {
   "id": "n1",
   "type": "replique",
   "chemin": "nodes.n1.text",
   "noeud": "n1",
   "partie": "Le grenier d'Ebéyé (jeu)",
   "personnage": "Le griot",
   "intonation": "chuchoté",
   "intonation_statut": "proposée",
   "texte": "Dans un village lyela, chacun connaît son voisin, et chacun croit tout savoir de lui. Ebéyé, une veuve, garde dans son grenier tout le mil de l'année. Cette nuit-là, une ombre vide le grenier.",
   "genre": "adulte/homme",
   "duree_ms": 14570,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Nder gariiri go'o, koo moye anndi bandiraawo maako, nden kam koo moye ɗon tammi anndugo koo ɗume dow maako. Mawɗo debbo mo'o maayi, ɗon cembiɗina nder ceede maako duuɓi ujune fuu. Nder jemma maajum, ɗii kammu ɓeydani suudu.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 16788,
     "fichier": "vur-n1-fuf.m4a"
    },
    "mos": {
     "texte": "Tẽng a yembr pʋgẽ, ned kam fãa mii a to. Ned kam fãa tagsdame t'a mii bũmb fãa yẽ zugu. Pʋg-kõorã sẽn yaa pʋg-paalã kogla a roogẽ bõn-buud fãa. Zĩ-kãng yʋngo, bi-bees sẽn da be roogã pʋgẽ wã ra pa le tarẽ ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 15886,
     "fichier": "vur-n1-mos.m4a"
    }
   }
  },
  {
   "id": "n2",
   "type": "replique",
   "chemin": "nodes.n2.text",
   "noeud": "n2",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Au matin, le village s'assemble. Un berger de passage arrive.",
   "genre": "adulte/homme",
   "duree_ms": 4550,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Nde subaka, yimɓe gariiri ɗon mooɓta. Goonɗinɗo go'o ɗon wara.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5546,
     "fichier": "vur-n2-fuf.m4a"
    },
    "mos": {
     "texte": "Vẽngrẽ wã, tẽn-tẽngã tigimdame. Kɩɩmb n wat be.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3402,
     "fichier": "vur-n2-mos.m4a"
    }
   }
  },
  {
   "id": "n3",
   "type": "replique",
   "chemin": "nodes.n3.text",
   "noeud": "n3",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le voisin",
   "intonation": "vif",
   "intonation_statut": "proposée",
   "texte": "C'est lui ! C'est forcément lui !",
   "genre": "adulte/homme",
   "duree_ms": 3260,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Kanko woni! Kanko woni ko o waɗi!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3050,
     "fichier": "vur-n3-fuf.m4a"
    },
    "mos": {
     "texte": "Yaa yẽ! Yaa yẽ bal n tõe n maan woto!",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 2874,
     "fichier": "vur-n3-mos.m4a"
    }
   }
  },
  {
   "id": "n4",
   "type": "replique",
   "chemin": "nodes.n4.text",
   "noeud": "n4",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Il a beau nier, personne ne l'écoute. Et toi, que dis-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 5460,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Koo to o haɓɓi, walaa mo nana. E mon, ɗume mbi'oton?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3946,
     "fichier": "vur-n4-fuf.m4a"
    },
    "mos": {
     "texte": "Baa a sã n kɩɩsda, ned baa a yen pa kelg-a ye. La yãmb me yetame tɩ bõe?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5802,
     "fichier": "vur-n4-mos.m4a"
    }
   }
  },
  {
