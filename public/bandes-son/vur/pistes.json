  {
   "id": "n5",
   "type": "replique",
   "chemin": "nodes.n5.text",
   "noeud": "n5",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "L'ancien te demande de redire ton avis devant tous. Le maintiens-tu ?",
   "genre": "adulte/homme",
   "duree_ms": 5160,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Mawɗo'en on ɗon toroo'on to yimɓe fuu mbi'a. On njogii mo naa?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 5514,
     "fichier": "vur-n5-fuf.m4a"
    },
    "mos": {
     "texte": "Kãsem-biigã kotame tɩ y lebs n togs y sẽn tagsdã nebã fãa taoore. Yãmb get-a lame bɩ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 7482,
     "fichier": "vur-n5-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n5.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n5.choices.0.label",
   "texte": "Non, tu retires ce que tu as dit",
   "langues": {
