  {
   "id": "injuste",
   "type": "replique",
   "chemin": "nodes.injuste.text",
   "noeud": "injuste",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "La foule te suit. Le berger reprend la route sous les pierres. Mais le mil ne revient pas, et le voleur, lui, reste au village. Ce chemin n'est pas celui du récit.",
   "genre": "adulte/homme",
   "duree_ms": 13810,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Yimɓe ɗon tokki ma. Goonɗinjo on fuɗɗiti laawol nder kaaƴe. Ammaa ɓooyma naa' ɗum warti, ammaa ɓorkoowo jooɗoto nder gariiri. Ɗuum woni laawol haala.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 12190,
     "fichier": "vur-injuste-fuf.m4a"
    },
    "mos": {
     "texte": "Neb kʋʋngã tũuda yãmba. Pe-kɩɩmbã leb n kẽnda kugẽ wã. La bõn-buudã ka lebg n wa ye, la wagdrã kell n bee tẽn-kãng pʋgẽ. Woto pa sor ning b sẽn togsã ye.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 13774,
     "fichier": "vur-injuste-mos.m4a"
    }
   }
  },
  {
   "id": "preuve",
   "type": "replique",
   "chemin": "nodes.preuve.text",
   "noeud": "preuve",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "posé",
   "intonation_statut": "proposée",
   "texte": "Les anciens se réunissent. Personne n'a rien vu, et chacun soupçonne l'autre. Ils décident de s'en remettre au vur.",
   "genre": "adulte/homme",
   "duree_ms": 8270,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Mawɓe ɗon kawta. Walaa go'oto yi'i kooɗume, nden kam ɓe fuu ɓe ɗon du'ana woɓɓe. Kamɓe ɓe njokki haala maɓɓe.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8836,
     "fichier": "vur-preuve-fuf.m4a"
    },
    "mos": {
     "texte": "Kãsem dãmbã tigimdame. Ned pa yã bũmb ye, tɩ ned kam fãa tagsd a to yelle. B yãka yam n na n bas-a lame.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 8996,
     "fichier": "vur-preuve-mos.m4a"
    }
   }
  },
  {
   "id": "n6",
   "type": "replique",
   "chemin": "nodes.n6.text",
   "noeud": "n6",
   "partie": "Le village s'assemble (jeu)",
   "personnage": "Le griot",
   "intonation": "interrogatif",
   "intonation_statut": "proposée",
   "texte": "Ils partent vers le lieu du vur. Veux-tu les suivre ?",
   "genre": "adulte/homme",
   "duree_ms": 4780,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "Ɓe ɗon njaha haa nokkuure wooɗugo. A yiɗi tokkugo ɓe?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 3898,
     "fichier": "vur-n6-fuf.m4a"
    },
    "mos": {
     "texte": "B kẽnga tẽn-kʋdgã zĩigẽ. Yãmb dat n tũ-b lame bɩ?",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4378,
     "fichier": "vur-n6-mos.m4a"
    }
   }
  },
  {
   "id": "nodes.n6.choices.0.label",
   "type": "choix",
   "chemin": "nodes.n6.choices.0.label",
   "texte": "Non, ce n'est pas à toi d'y aller",
   "langues": {
    "fuf": {
     "texte": "Na'o, ɗum to maaɗa yahugo",
     "relecture": "traduction automatique, non relue"
    },
    "mos": {
     "texte": "N-ye, pa yãmb n segd n kẽng ye",
     "relecture": "traduction automatique, non relue"
    }
   }
  },
  {
