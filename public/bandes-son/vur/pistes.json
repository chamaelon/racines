   "langues": {
    "fuf": {
     "texte": "Walaa ko ɓe mbi'ata dow maajum. Walaa ko hollata, sey hendu, jayngol e nyiwre. On nji'ataa kooɗume.",
     "relecture": "traduction automatique, non relue",
