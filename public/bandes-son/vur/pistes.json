   "partie": "Le village s'assemble (jeu)",
   "personnage": "L'ancien",
   "intonation": "grave",
   "intonation_statut": "proposée",
   "texte": "Sans preuve, on ne condamne personne. Tu le sais pourtant.",
   "genre": "âgé/homme",
   "duree_ms": 4550,
   "duree_statut": "estimée",
   "langues": {
    "fuf": {
     "texte": "To walaa daliila, a waɗataa goɗɗo hakke. On andi non.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4634,
     "fichier": "vur-chasse-fuf.m4a"
    },
    "mos": {
     "texte": "Ned sã n pa tar kaset, a ka tõe n kao ned bʋʋd ye. La yãmb mii rẽ.",
     "relecture": "traduction automatique, non relue",
     "statut": "enregistre",
     "duree_ms": 4778,
